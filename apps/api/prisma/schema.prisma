// ---------------------------------------------------------------------------
// Phase 3 — Journal (double-entry)
// ---------------------------------------------------------------------------

model JournalEntry {
  id             BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId       BigInt             @map("tenant_id") @db.UnsignedBigInt
  companyId      BigInt             @map("company_id") @db.UnsignedBigInt
  branchId       BigInt?            @map("branch_id") @db.UnsignedBigInt
  entryNo        String?            @map("entry_no") @db.VarChar(50)
  entryDate      DateTime           @map("entry_date") @db.Date
  fiscalPeriodId BigInt?            @map("fiscal_period_id") @db.UnsignedBigInt
  sourceType     String             @map("source_type") @db.VarChar(50)
  sourceId       BigInt?            @map("source_id") @db.UnsignedBigInt
  postingKind    JournalPostingKind @default(POST) @map("posting_kind")
  voucherType    JournalVoucherType @default(JOURNAL) @map("voucher_type")
  status         JournalEntryStatus @default(DRAFT)
  description    String?            @db.VarChar(500)
  totalDebit     Decimal            @default(0) @map("total_debit") @db.Decimal(18, 3)
  totalCredit    Decimal            @default(0) @map("total_credit") @db.Decimal(18, 3)
  reversalOfId   BigInt?            @map("reversal_of_id") @db.UnsignedBigInt
  /// Opening balances (§8.6, ADR-008): the opening entry and the entries of
  /// OPENING stock adjustments, and their reversals. Reports show these
  /// lines as the opening balance of a period, not as movements.
  isOpening      Boolean            @default(false) @map("is_opening")
  postedAt       DateTime?          @map("posted_at") @db.DateTime(3)
  postedBy       BigInt?            @map("posted_by") @db.UnsignedBigInt
  createdAt      DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company           @relation(fields: [tenantId, companyId], references: [tenantId, id])
  branch           Branch?           @relation(fields: [tenantId, branchId], references: [tenantId, id])
  fiscalPeriod     FiscalPeriod?     @relation(fields: [tenantId, fiscalPeriodId], references: [tenantId, id])
  reversalOf       JournalEntry?     @relation("EntryReversal", fields: [tenantId, reversalOfId], references: [tenantId, id])
  reversals        JournalEntry[]    @relation("EntryReversal")
  lines            JournalLine[]
  stockAdjustments StockAdjustment[]
  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  salesReturns     SalesReturn[]
  purchaseReturns  PurchaseReturn[]
  goodsNotes       GoodsNote[]
  receipts         Receipt[]
  payments         Payment[]
  cashTransfers    CashTransfer[]

  @@unique([tenantId, id])
  // One POST + one REVERSAL per source document (docs/BUILD_PLAN.md §10.3).
  // MySQL treats NULL source_id as distinct — drafts set source_id = own id.
  @@unique([tenantId, sourceType, sourceId, postingKind])
  // An entry is reversed at most once (D-1, LEDGER-02): "reversed" is derived
  // from the reversal that points here. NULL (not a reversal) repeats freely.
  @@unique([tenantId, reversalOfId])
  @@index([tenantId, companyId, entryDate])
  // Reports read posted entries of a company by date (DB-10).
  @@index([tenantId, companyId, status, entryDate])
  @@map("journal_entries")
}

model JournalLine {
  id             BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId       BigInt            @map("tenant_id") @db.UnsignedBigInt
  journalEntryId BigInt            @map("journal_entry_id") @db.UnsignedBigInt
  lineNo         Int               @map("line_no")
  accountId      BigInt            @map("account_id") @db.UnsignedBigInt
  debit          Decimal           @default(0) @db.Decimal(18, 3)
  credit         Decimal           @default(0) @db.Decimal(18, 3)
  partyType      JournalPartyType? @map("party_type")
  partyId        BigInt?           @map("party_id") @db.UnsignedBigInt
  description    String?           @db.VarChar(500)
  branchId       BigInt?           @map("branch_id") @db.UnsignedBigInt
  /// ADR-024 §1.7: no foreign key, like party_id and branch_id. A used centre is
  /// deactivated, never deleted (CostCentersService), and job:integrity-check
  /// counts orphans. Income-statement lines only.
  costCenterId   BigInt?           @map("cost_center_id") @db.UnsignedBigInt
  /// Copy of the entry's date (LEDGER-19): an entry's date never changes once
  /// its lines exist, so statements can seek on the line indexes below.
  /// Written with the lines (PostingService, draft creation in JournalService).
  entryDate      DateTime          @map("entry_date") @db.Date
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  entry   JournalEntry @relation(fields: [tenantId, journalEntryId], references: [tenantId, id], onDelete: Cascade)
  account Account      @relation(fields: [tenantId, accountId], references: [tenantId, id])
  tenant  Tenant       @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, journalEntryId, lineNo])
  // Ledger and balances per account: the entry join key is in the index (DB-10).
  @@index([tenantId, accountId, journalEntryId])
  // Party statement and control balances per party (aging).
  @@index([tenantId, partyType, partyId, journalEntryId])
  // LEDGER-19: covers the per-account sums of the trial balance and the
  // statements, so dated reports read lines from the index only, driven by
  // the dated entries (a month no longer costs as much as the whole ledger).
  @@index([tenantId, journalEntryId, accountId, debit, credit], map: "journal_lines_entry_cover_idx")
  // ADR-022 §4 / LEDGER-19: an account or party statement page seeks to its
  // cursor in statement order (entry date, entry id, line no) and reads on.
  @@index([tenantId, accountId, entryDate, journalEntryId, lineNo], map: "journal_lines_account_seek_idx")
  @@index([tenantId, partyType, partyId, entryDate, journalEntryId, lineNo], map: "journal_lines_party_seek_idx")
  // ADR-024 §1.8: the cost-centre statement seeks like the account statement. The only
  // cost-centre index on journal_lines; the income statement by centre is measured without one.
  @@index([tenantId, costCenterId, entryDate, journalEntryId, lineNo], map: "journal_lines_cost_center_seek_idx")
  @@map("journal_lines")
}

// ---------------------------------------------------------------------------
// Phase 11 — cost centres (ADR-013 §3, ADR-024 §1)
// ---------------------------------------------------------------------------

/// A tree of cost centres per company, apart from the branches. Only a leaf
/// (`isPostable`) takes lines; a centre that is used is deactivated, not deleted.
model CostCenter {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId   BigInt   @map("tenant_id") @db.UnsignedBigInt
  companyId  BigInt   @map("company_id") @db.UnsignedBigInt
  code       String   @db.VarChar(50)
  nameAr     String   @map("name_ar") @db.VarChar(191)
  nameEn     String?  @map("name_en") @db.VarChar(191)
  parentId   BigInt?  @map("parent_id") @db.UnsignedBigInt
  /// False once the centre has a child (a group takes no lines).
  isPostable Boolean  @default(true) @map("is_postable")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy  BigInt?  @map("created_by") @db.UnsignedBigInt
  updatedBy  BigInt?  @map("updated_by") @db.UnsignedBigInt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company           @relation(fields: [tenantId, companyId], references: [tenantId, id])
  parent           CostCenter?       @relation("CostCenterTree", fields: [tenantId, companyId, parentId], references: [tenantId, companyId, id])
  children         CostCenter[]      @relation("CostCenterTree")
  salesInvoices    SalesInvoice[]
  salesReturns     SalesReturn[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  receipts         Receipt[]
  payments         Payment[]
  purchaseOrders   PurchaseOrder[]
  goodsNotes       GoodsNote[]
  issueRequests    IssueRequest[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, id])
  @@unique([tenantId, companyId, code])
  @@map("cost_centers")
  salesQuotes SalesQuote[]
  salesOrders SalesOrder[]
}

