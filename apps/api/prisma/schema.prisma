  parent       Account?         @relation("AccountTree", fields: [tenantId, companyId, parentId], references: [tenantId, companyId, id])
  children     Account[]        @relation("AccountTree")
  mappings     AccountMapping[]
  journalLines JournalLine[]
  cashBoxes         CashBox[]
  bankAccounts      BankAccount[]
  salesInvoiceCashAccounts   SalesInvoice[]    @relation("SalesInvoiceCashAccount")
  purchaseInvoiceCashAccounts PurchaseInvoice[] @relation("PurchaseInvoiceCashAccount")
  salesReturnCashAccounts    SalesReturn[]     @relation("SalesReturnCashAccount")
  purchaseReturnCashAccounts PurchaseReturn[]  @relation("PurchaseReturnCashAccount")
  receiptCashAccounts        Receipt[]         @relation("ReceiptCashAccount")
  paymentCashAccounts        Payment[]         @relation("PaymentCashAccount")
  paymentExpenseAccounts     Payment[]         @relation("PaymentExpenseAccount")
  cashTransfersFrom          CashTransfer[]    @relation("CashTransferFrom")
  cashTransfersTo            CashTransfer[]    @relation("CashTransferTo")
  goodsNoteExpenseAccounts   GoodsNote[]       @relation("GoodsNoteExpenseAccount")
