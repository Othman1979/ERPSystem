}

model SalesInvoice {
  id             BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId       BigInt              @map("tenant_id") @db.UnsignedBigInt
  companyId      BigInt              @map("company_id") @db.UnsignedBigInt
  branchId       BigInt?             @map("branch_id") @db.UnsignedBigInt
  invoiceNo      String?             @map("invoice_no") @db.VarChar(50)
  invoiceDate    DateTime            @map("invoice_date") @db.Date
  dueDate        DateTime?           @map("due_date") @db.Date
  customerId     BigInt              @map("customer_id") @db.UnsignedBigInt
  warehouseId    BigInt              @map("warehouse_id") @db.UnsignedBigInt
  paymentType    InvoicePaymentType  @map("payment_type")
  cashAccountId  BigInt?             @map("cash_account_id") @db.UnsignedBigInt
  status         DocumentStatus      @default(DRAFT)
  description    String?             @db.VarChar(500)
  netTotal       Decimal             @default(0) @map("net_total") @db.Decimal(18, 3)
  taxTotal       Decimal             @default(0) @map("tax_total") @db.Decimal(18, 3)
  grandTotal     Decimal             @default(0) @map("grand_total") @db.Decimal(18, 3)
  paidAmount     Decimal             @default(0) @map("paid_amount") @db.Decimal(18, 3)
  costTotal      Decimal             @default(0) @map("cost_total") @db.Decimal(18, 3)
  journalEntryId BigInt?             @map("journal_entry_id") @db.UnsignedBigInt
  postedAt       DateTime?           @map("posted_at") @db.DateTime(3)
  postedBy       BigInt?             @map("posted_by") @db.UnsignedBigInt
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy      BigInt?             @map("created_by") @db.UnsignedBigInt
  updatedBy      BigInt?             @map("updated_by") @db.UnsignedBigInt

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company      Company             @relation(fields: [tenantId, companyId], references: [tenantId, id])
  customer     Party               @relation(fields: [tenantId, customerId], references: [tenantId, id])
  warehouse    Warehouse           @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  cashAccount  Account?            @relation("SalesInvoiceCashAccount", fields: [tenantId, companyId, cashAccountId], references: [tenantId, companyId, id])
  journalEntry JournalEntry?       @relation(fields: [tenantId, journalEntryId], references: [tenantId, id])
  lines        SalesInvoiceLine[]
  returns      SalesReturn[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, invoiceNo])
  // Lists: ORDER BY invoice_date DESC, id DESC (DB-10).
  @@index([tenantId, companyId, invoiceDate, id])
  // Posted-only counts and sums by date: monthly quota on every post, summaries.
  @@index([tenantId, companyId, status, invoiceDate])
  // Oldest-first settlement and aging per customer; also the customer FK.
  @@index([tenantId, customerId, status, paymentType, invoiceDate])
  @@map("sales_invoices")
}

model SalesInvoiceLine {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
