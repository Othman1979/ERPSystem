  cashAccountId   BigInt              @map("cash_account_id") @db.UnsignedBigInt
  amount          Decimal             @db.Decimal(18, 3)
  paymentMethodId BigInt?             @map("payment_method_id") @db.UnsignedBigInt
  referenceNo     String?             @map("reference_no") @db.VarChar(100)
  description     String?             @db.VarChar(500)
  status          DocumentStatus      @default(POSTED)
  journalEntryId  BigInt?             @map("journal_entry_id") @db.UnsignedBigInt
  /// ADR-003: branch from the request context at creation.
  branchId        BigInt?             @map("branch_id") @db.UnsignedBigInt
  /// Reversal (Phase 6): set once; the original stays POSTED and immutable.
  reversedAt      DateTime?           @map("reversed_at") @db.DateTime(3)
  reversedBy      BigInt?             @map("reversed_by") @db.UnsignedBigInt
  reversalEntryId BigInt?             @map("reversal_entry_id") @db.UnsignedBigInt
  createdAt       DateTime            @default(now()) @map("created_at") @db.DateTime(3)
