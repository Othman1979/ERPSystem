  // Posted-only sums by date: summaries, aging.
  @@index([tenantId, companyId, status, invoiceDate])
  // Oldest-first settlement and aging per supplier; also the supplier FK.
  @@index([tenantId, supplierId, status, paymentType, invoiceDate])
  @@map("purchase_invoices")
