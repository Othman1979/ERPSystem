  note   GoodsNote  @relation(fields: [tenantId, noteId], references: [tenantId, id], onDelete: Cascade)
  item   Item       @relation(fields: [tenantId, itemId], references: [tenantId, id])
  poLine PurchaseOrderLine? @relation(fields: [tenantId, poLineId], references: [tenantId, id])
  issueRequestLine IssueRequestLine? @relation(fields: [tenantId, issueRequestLineId], references: [tenantId, id])
  invoiceReceipts PurchaseInvoiceReceipt[]

  @@unique([tenantId, id])
  @@unique([tenantId, noteId, lineNo])
  @@index([tenantId, poLineId])
  @@index([tenantId, issueRequestLineId])
  @@map("goods_note_lines")
}

model Receipt {
  id              BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId        BigInt              @map("tenant_id") @db.UnsignedBigInt
  companyId       BigInt              @map("company_id") @db.UnsignedBigInt
  receiptNo       String?             @map("receipt_no") @db.VarChar(50)
  receiptDate     DateTime            @map("receipt_date") @db.Date
  partyType       JournalPartyType    @map("party_type")
  partyId         BigInt              @map("party_id") @db.UnsignedBigInt
  cashAccountId   BigInt              @map("cash_account_id") @db.UnsignedBigInt
  /// ADR-024 §1.2: copied onto every income-statement line of the document's entry.
  costCenterId   BigInt?             @map("cost_center_id") @db.UnsignedBigInt
  amount          Decimal             @db.Decimal(18, 3)
  paymentMethodId BigInt?             @map("payment_method_id") @db.UnsignedBigInt
  referenceNo     String?             @map("reference_no") @db.VarChar(100)
  description     String?             @db.VarChar(500)
  status          DocumentStatus      @default(POSTED)
  journalEntryId  BigInt?             @map("journal_entry_id") @db.UnsignedBigInt
  /// ADR-003: branch from the request context at creation.
  branchId        BigInt?             @map("branch_id") @db.UnsignedBigInt
  /// Reversal (Phase 6): set once; the original stays POSTED and immutable.
  reversedAt      DateTime?           @map("reversed_at") @db.DateTime(3)
  reversedBy      BigInt?             @map("reversed_by") @db.UnsignedBigInt
  reversalEntryId BigInt?             @map("reversal_entry_id") @db.UnsignedBigInt
  createdAt       DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  createdBy       BigInt?             @map("created_by") @db.UnsignedBigInt

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company      @relation(fields: [tenantId, companyId], references: [tenantId, id])
  party          Party        @relation(fields: [tenantId, partyId], references: [tenantId, id])
  cashAccount    Account      @relation("ReceiptCashAccount", fields: [tenantId, companyId, cashAccountId], references: [tenantId, companyId, id])
  costCenter   CostCenter?          @relation(fields: [tenantId, companyId, costCenterId], references: [tenantId, companyId, id])
  paymentMethod  PaymentMethod? @relation(fields: [tenantId, paymentMethodId], references: [tenantId, id])
  journalEntry   JournalEntry? @relation(fields: [tenantId, journalEntryId], references: [tenantId, id])
  allocations    Allocation[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, receiptNo])
  // Lists: ORDER BY receipt_date DESC, id DESC (DB-10).
  @@index([tenantId, companyId, receiptDate, id])
  @@map("receipts")
}

model Payment {
  id              BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId        BigInt              @map("tenant_id") @db.UnsignedBigInt
  companyId       BigInt              @map("company_id") @db.UnsignedBigInt
  paymentNo       String?             @map("payment_no") @db.VarChar(50)
  paymentDate     DateTime            @map("payment_date") @db.Date
  partyType       JournalPartyType?   @map("party_type")
  partyId         BigInt?             @map("party_id") @db.UnsignedBigInt
  expenseAccountId BigInt?            @map("expense_account_id") @db.UnsignedBigInt
  cashAccountId   BigInt              @map("cash_account_id") @db.UnsignedBigInt
  /// ADR-024 §1.2: copied onto every income-statement line of the document's entry.
  costCenterId   BigInt?             @map("cost_center_id") @db.UnsignedBigInt
  amount          Decimal             @db.Decimal(18, 3)
  paymentMethodId BigInt?             @map("payment_method_id") @db.UnsignedBigInt
  referenceNo     String?             @map("reference_no") @db.VarChar(100)
  description     String?             @db.VarChar(500)
  status          DocumentStatus      @default(POSTED)
  journalEntryId  BigInt?             @map("journal_entry_id") @db.UnsignedBigInt
  /// ADR-003: branch from the request context at creation.
  branchId        BigInt?             @map("branch_id") @db.UnsignedBigInt
  /// Reversal (Phase 6): set once; the original stays POSTED and immutable.
  reversedAt      DateTime?           @map("reversed_at") @db.DateTime(3)
  reversedBy      BigInt?             @map("reversed_by") @db.UnsignedBigInt
  reversalEntryId BigInt?             @map("reversal_entry_id") @db.UnsignedBigInt
  createdAt       DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  createdBy       BigInt?             @map("created_by") @db.UnsignedBigInt

  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company       @relation(fields: [tenantId, companyId], references: [tenantId, id])
  party          Party?        @relation(fields: [tenantId, partyId], references: [tenantId, id])
  expenseAccount Account?      @relation("PaymentExpenseAccount", fields: [tenantId, companyId, expenseAccountId], references: [tenantId, companyId, id])
  cashAccount    Account       @relation("PaymentCashAccount", fields: [tenantId, companyId, cashAccountId], references: [tenantId, companyId, id])
  costCenter   CostCenter?          @relation(fields: [tenantId, companyId, costCenterId], references: [tenantId, companyId, id])
  paymentMethod  PaymentMethod? @relation(fields: [tenantId, paymentMethodId], references: [tenantId, id])
  journalEntry   JournalEntry? @relation(fields: [tenantId, journalEntryId], references: [tenantId, id])
  allocations    Allocation[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, paymentNo])
  // Lists: ORDER BY payment_date DESC, id DESC (DB-10).
  @@index([tenantId, companyId, paymentDate, id])
  @@map("payments")
}

model Allocation {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId      BigInt   @map("tenant_id") @db.UnsignedBigInt
  companyId     BigInt   @map("company_id") @db.UnsignedBigInt
  receiptId     BigInt?  @map("receipt_id") @db.UnsignedBigInt
  paymentId     BigInt?  @map("payment_id") @db.UnsignedBigInt
  partyType     JournalPartyType @map("party_type")
  partyId       BigInt   @map("party_id") @db.UnsignedBigInt
  documentType  String   @map("document_type") @db.VarChar(50)
  documentId    BigInt   @map("document_id") @db.UnsignedBigInt
  amount        Decimal  @db.Decimal(18, 3)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  createdBy     BigInt?  @map("created_by") @db.UnsignedBigInt
  /// Cancelled allocations are kept for history; only active ones count.
  cancelledAt   DateTime? @map("cancelled_at") @db.DateTime(3)
  cancelledBy   BigInt?  @map("cancelled_by") @db.UnsignedBigInt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company  @relation(fields: [tenantId, companyId], references: [tenantId, id])
  receipt Receipt? @relation(fields: [tenantId, receiptId], references: [tenantId, id])
  payment Payment? @relation(fields: [tenantId, paymentId], references: [tenantId, id])
  party   Party    @relation(fields: [tenantId, partyId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, documentType, documentId])
  // Allocated amount per voucher (also the receipt / payment FKs).
  @@index([tenantId, receiptId])
  @@index([tenantId, paymentId])
  @@map("allocations")
}

/// Phase 6 (§7.8): money moved between two cash/bank accounts of the company.
/// Posted on creation (Dr to, Cr from); corrected only by reversal.
model CashTransfer {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId        BigInt         @map("tenant_id") @db.UnsignedBigInt
  companyId       BigInt         @map("company_id") @db.UnsignedBigInt
  /// ADR-003: branch from the request context at creation.
  branchId        BigInt?        @map("branch_id") @db.UnsignedBigInt
  transferNo      String?        @map("transfer_no") @db.VarChar(50)
  transferDate    DateTime       @map("transfer_date") @db.Date
  fromAccountId   BigInt         @map("from_account_id") @db.UnsignedBigInt
  toAccountId     BigInt         @map("to_account_id") @db.UnsignedBigInt
  amount          Decimal        @db.Decimal(18, 3)
  referenceNo     String?        @map("reference_no") @db.VarChar(100)
  description     String?        @db.VarChar(500)
  status          DocumentStatus @default(POSTED)
  journalEntryId  BigInt?        @map("journal_entry_id") @db.UnsignedBigInt
  reversedAt      DateTime?      @map("reversed_at") @db.DateTime(3)
  reversedBy      BigInt?        @map("reversed_by") @db.UnsignedBigInt
  reversalEntryId BigInt?        @map("reversal_entry_id") @db.UnsignedBigInt
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  createdBy       BigInt?        @map("created_by") @db.UnsignedBigInt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company      Company       @relation(fields: [tenantId, companyId], references: [tenantId, id])
  fromAccount  Account       @relation("CashTransferFrom", fields: [tenantId, companyId, fromAccountId], references: [tenantId, companyId, id])
  toAccount    Account       @relation("CashTransferTo", fields: [tenantId, companyId, toAccountId], references: [tenantId, companyId, id])
  journalEntry JournalEntry? @relation(fields: [tenantId, journalEntryId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, transferNo])
  @@index([tenantId, transferDate])
  // ADR-022: the list pages by date, newest first.
  @@index([tenantId, companyId, transferDate, id])
  @@map("cash_transfers")
}

// ---------------------------------------------------------------------------
// Phase 7 — JoFotara e-invoicing (docs/decisions/0005-jofotara-fields.md)
// ---------------------------------------------------------------------------

enum NationalIdKind {
  NIN
  PN
}

enum EInvoiceEnvironment {
  SANDBOX
  PRODUCTION
}

enum EInvoiceTrack {
  INCOME
  GENERAL_SALES
}

enum EInvoiceStatus {
  PENDING
  SENDING
  ACCEPTED
  REJECTED
  FAILED
  UNKNOWN
}

/// JoFotara connection of one company (0005 §10). The Secret-Key is stored
/// only AES-256-GCM sealed (EINVOICE_ENC_KEY) and never returned by the API.
model EInvoiceSettings {
  id                   BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId             BigInt              @map("tenant_id") @db.UnsignedBigInt
  companyId            BigInt              @map("company_id") @db.UnsignedBigInt
  environment          EInvoiceEnvironment @default(SANDBOX)
  /// SANDBOX only: the local mock (jofotara-kit serve). PRODUCTION always uses the official URL.
  baseUrl              String?             @map("base_url") @db.VarChar(255)
  clientId             String?             @map("client_id") @db.VarChar(191)
  secretEncrypted      String?             @map("secret_encrypted") @db.VarChar(512)
  incomeSourceSequence String?             @map("income_source_sequence") @db.VarChar(50)
  track                EInvoiceTrack       @default(GENERAL_SALES)
  /// Next invoice counter (ICV); taken under a row lock when a document is queued.
  nextIcv              Int                 @default(1) @map("next_icv")
  isEnabled            Boolean             @default(false) @map("is_enabled")
  /// Documents posted before this moment are never sent.
  enabledAt            DateTime?           @map("enabled_at") @db.DateTime(3)
  createdAt            DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy            BigInt?             @map("created_by") @db.UnsignedBigInt
  updatedBy            BigInt?             @map("updated_by") @db.UnsignedBigInt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [tenantId, companyId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, companyId])
  @@map("einvoice_settings")
}

/// One posted sales invoice or sales return on its way to JoFotara (0005 §13).
/// ID + UUID + ICV are fixed when it is queued; every retry reuses them.
model EInvoiceSubmission {
  id                   BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId             BigInt              @map("tenant_id") @db.UnsignedBigInt
  companyId            BigInt              @map("company_id") @db.UnsignedBigInt
  /// SALES_INVOICE | SALES_RETURN
  documentType         String              @map("document_type") @db.VarChar(30)
  documentId           BigInt              @map("document_id") @db.UnsignedBigInt
  /// ADR-003 §10: the document's branch (a return's is its invoice's), set at enqueue.
  branchId             BigInt?             @map("branch_id") @db.UnsignedBigInt
  documentNo           String              @map("document_no") @db.VarChar(50)
  uuid                 String              @db.Char(36)
  icv                  Int
  environment          EInvoiceEnvironment
  status               EInvoiceStatus      @default(PENDING)
  /// Automatic attempts since the last manual resend (at most 5 while FAILED).
  attemptCount         Int                 @default(0) @map("attempt_count")
  nextAttemptAt        DateTime            @default(now()) @map("next_attempt_at") @db.DateTime(3)
  claimToken           String?             @map("claim_token") @db.Char(36)
  claimedAt            DateTime?           @map("claimed_at") @db.DateTime(3)
  /// A manual resend after UNKNOWN must send this exact XML again.
  reuseXml             Boolean             @default(false) @map("reuse_xml")
  originalSubmissionId BigInt?             @map("original_submission_id") @db.UnsignedBigInt
  /// The XML sent (no credentials in it).
  requestXml           String?             @map("request_xml") @db.MediumText
  responseCode         Int?                @map("response_code")
  responseBody         String?             @map("response_body") @db.MediumText
  /// [{ code, message, source }] from JoFotara or local validation.
  errors               Json?
  qrPayload            String?             @map("qr_payload") @db.Text
  governmentUuid       String?             @map("government_uuid") @db.VarChar(100)
  sentAt               DateTime?           @map("sent_at") @db.DateTime(3)
  completedAt          DateTime?           @map("completed_at") @db.DateTime(3)
  createdAt            DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company            Company              @relation(fields: [tenantId, companyId], references: [tenantId, id])
  branch             Branch?              @relation(fields: [tenantId, branchId], references: [tenantId, id])
  originalSubmission EInvoiceSubmission?  @relation("EInvoiceReturnOf", fields: [tenantId, originalSubmissionId], references: [tenantId, id])
  returnSubmissions  EInvoiceSubmission[] @relation("EInvoiceReturnOf")
  attempts           EInvoiceAttempt[]

  @@unique([tenantId, id])
  @@unique([tenantId, documentType, documentId])
  @@unique([tenantId, companyId, icv])
  @@index([status, nextAttemptAt])
  @@index([claimToken])
  // The worker's stuck-row recovery reads SENDING rows older than a cutoff.
  @@index([status, claimedAt])
  // ADR-022: the submissions list pages by creation, newest first.
  @@index([tenantId, companyId, createdAt, id])
  @@map("einvoice_submissions")
}

/// Every attempt to send a submission, with the raw answer (0005 §13).
model EInvoiceAttempt {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId     BigInt   @map("tenant_id") @db.UnsignedBigInt
  submissionId BigInt   @map("submission_id") @db.UnsignedBigInt
  attemptNo    Int      @map("attempt_no")
  /// accepted | rejected | unknown | not-sent
  outcome      String   @db.VarChar(20)
  httpStatus   Int?     @map("http_status")
  responseBody String?  @map("response_body") @db.MediumText
  message      String?  @db.VarChar(1000)
  startedAt    DateTime @map("started_at") @db.DateTime(3)
  finishedAt   DateTime @map("finished_at") @db.DateTime(3)

  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  submission EInvoiceSubmission @relation(fields: [tenantId, submissionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, submissionId, attemptNo])
  @@map("einvoice_attempts")
}

// ---------------------------------------------------------------------------
// Phase 12 — purchase requests, quotes and orders (ADR-025). None of these
// documents posts a journal entry or a stock movement.
// ---------------------------------------------------------------------------

/// Internal request to buy (ADR-025 §1, FULL level only). Numbered PRQ at approval.
model PurchaseRequest {
  id           BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId     BigInt                @map("tenant_id") @db.UnsignedBigInt
  companyId    BigInt                @map("company_id") @db.UnsignedBigInt
  /// The branch of the request context when the draft was created (ADR-003).
  branchId     BigInt?               @map("branch_id") @db.UnsignedBigInt
  requestNo    String?               @map("request_no") @db.VarChar(50)
  requestDate  DateTime              @map("request_date") @db.Date
  neededBy     DateTime?             @map("needed_by") @db.Date
  status       PurchaseRequestStatus @default(DRAFT)
  notes        String?               @db.VarChar(500)
  submittedAt  DateTime?             @map("submitted_at") @db.DateTime(3)
  submittedBy  BigInt?               @map("submitted_by") @db.UnsignedBigInt
  approvedAt   DateTime?             @map("approved_at") @db.DateTime(3)
  approvedBy   BigInt?               @map("approved_by") @db.UnsignedBigInt
  rejectedAt   DateTime?             @map("rejected_at") @db.DateTime(3)
  rejectedBy   BigInt?               @map("rejected_by") @db.UnsignedBigInt
  rejectReason String?               @map("reject_reason") @db.VarChar(500)
  cancelledAt  DateTime?             @map("cancelled_at") @db.DateTime(3)
  cancelledBy  BigInt?               @map("cancelled_by") @db.UnsignedBigInt
  cancelReason String?               @map("cancel_reason") @db.VarChar(500)
  closedAt     DateTime?             @map("closed_at") @db.DateTime(3)
  closedBy     BigInt?               @map("closed_by") @db.UnsignedBigInt
  createdAt    DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy    BigInt?               @map("created_by") @db.UnsignedBigInt
  updatedBy    BigInt?               @map("updated_by") @db.UnsignedBigInt

  tenant  Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company               @relation(fields: [tenantId, companyId], references: [tenantId, id])
  branch  Branch?               @relation(fields: [tenantId, branchId], references: [tenantId, id])
  lines   PurchaseRequestLine[]
  quotes  PurchaseQuote[]
  orders  PurchaseOrder[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, requestNo])
  // Lists: ORDER BY request_date DESC, id DESC.
  @@index([tenantId, companyId, requestDate, id])
  // Open-documents counter (ADR-025 §6).
  @@index([tenantId, status])
  @@map("purchase_requests")
}

/// A requested item. ordered_qty: in the line's unit, on purchase orders that are not cancelled (ADR-025 §9).
model PurchaseRequestLine {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId       BigInt   @map("tenant_id") @db.UnsignedBigInt
  requestId      BigInt   @map("request_id") @db.UnsignedBigInt
  lineNo         Int      @map("line_no")
  itemId         BigInt   @map("item_id") @db.UnsignedBigInt
  itemUnitId     BigInt?  @map("item_unit_id") @db.UnsignedBigInt
  qty            Decimal  @db.Decimal(18, 6)
  qtyBase        Decimal  @map("qty_base") @db.Decimal(18, 6)
  /// Optional estimate per unit; not binding, so approval ignores it (ADR-025 §2).
  estimatedPrice Decimal? @map("estimated_price") @db.Decimal(18, 6)
  note           String?  @db.VarChar(500)
  orderedQty     Decimal  @default(0) @map("ordered_qty") @db.Decimal(18, 6)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request    PurchaseRequest     @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Cascade)
  item       Item                @relation(fields: [tenantId, itemId], references: [tenantId, id])
  itemUnit   ItemUnit?           @relation(fields: [tenantId, itemUnitId], references: [tenantId, id])
  quoteLines PurchaseQuoteLine[]
  orderLines PurchaseOrderLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, requestId, lineNo])
  @@map("purchase_request_lines")
}

/// Request for quotation sent to one supplier for an approved request (ADR-025 §1, FULL only). Numbered RFQ when sent.
model PurchaseQuote {
  id               BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId         BigInt              @map("tenant_id") @db.UnsignedBigInt
  companyId        BigInt              @map("company_id") @db.UnsignedBigInt
  /// The request's branch.
  branchId         BigInt?             @map("branch_id") @db.UnsignedBigInt
  requestId        BigInt              @map("request_id") @db.UnsignedBigInt
  supplierId       BigInt              @map("supplier_id") @db.UnsignedBigInt
  quoteNo          String?             @map("quote_no") @db.VarChar(50)
  quoteDate        DateTime            @map("quote_date") @db.Date
  validUntil       DateTime?           @map("valid_until") @db.Date
  /// The supplier's own reference for the offer, entered with the prices.
  supplierRef      String?             @map("supplier_ref") @db.VarChar(100)
  /// ADR-017: prices entered including tax (company setting when the draft was saved).
  pricesIncludeTax Boolean             @default(false) @map("prices_include_tax")
  status           PurchaseQuoteStatus @default(DRAFT)
  notes            String?             @db.VarChar(500)
  netTotal         Decimal             @default(0) @map("net_total") @db.Decimal(18, 3)
  taxTotal         Decimal             @default(0) @map("tax_total") @db.Decimal(18, 3)
  grandTotal       Decimal             @default(0) @map("grand_total") @db.Decimal(18, 3)
  sentAt           DateTime?           @map("sent_at") @db.DateTime(3)
  sentBy           BigInt?             @map("sent_by") @db.UnsignedBigInt
  receivedAt       DateTime?           @map("received_at") @db.DateTime(3)
  receivedBy       BigInt?             @map("received_by") @db.UnsignedBigInt
  closedAt         DateTime?           @map("closed_at") @db.DateTime(3)
  closedBy         BigInt?             @map("closed_by") @db.UnsignedBigInt
  cancelledAt      DateTime?           @map("cancelled_at") @db.DateTime(3)
  cancelledBy      BigInt?             @map("cancelled_by") @db.UnsignedBigInt
  cancelReason     String?             @map("cancel_reason") @db.VarChar(500)
  createdAt        DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy        BigInt?             @map("created_by") @db.UnsignedBigInt
  updatedBy        BigInt?             @map("updated_by") @db.UnsignedBigInt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company  Company             @relation(fields: [tenantId, companyId], references: [tenantId, id])
  branch   Branch?             @relation(fields: [tenantId, branchId], references: [tenantId, id])
  request  PurchaseRequest     @relation(fields: [tenantId, requestId], references: [tenantId, id])
  supplier Party               @relation(fields: [tenantId, supplierId], references: [tenantId, id])
  lines    PurchaseQuoteLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, quoteNo])
  @@index([tenantId, companyId, quoteDate, id])
  @@index([tenantId, requestId, status])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
  @@map("purchase_quotes")
}

/// A quoted line for one request line; prices and amounts are set when the quote is received.
model PurchaseQuoteLine {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId       BigInt   @map("tenant_id") @db.UnsignedBigInt
  quoteId        BigInt   @map("quote_id") @db.UnsignedBigInt
  lineNo         Int      @map("line_no")
  requestLineId  BigInt   @map("request_line_id") @db.UnsignedBigInt
  itemId         BigInt   @map("item_id") @db.UnsignedBigInt
  itemUnitId     BigInt?  @map("item_unit_id") @db.UnsignedBigInt
  qty            Decimal  @db.Decimal(18, 6)
  qtyBase        Decimal  @map("qty_base") @db.Decimal(18, 6)
  unitPrice      Decimal? @map("unit_price") @db.Decimal(18, 6)
  discountPct    Decimal  @default(0) @map("discount_pct") @db.Decimal(9, 4)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 3)
  netAmount      Decimal  @default(0) @map("net_amount") @db.Decimal(18, 3)
  taxCategoryId  BigInt?  @map("tax_category_id") @db.UnsignedBigInt
  taxRate        Decimal  @default(0) @map("tax_rate") @db.Decimal(9, 4)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 3)
  lineTotal      Decimal  @default(0) @map("line_total") @db.Decimal(18, 3)
  note           String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote       PurchaseQuote       @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Cascade)
  requestLine PurchaseRequestLine @relation(fields: [tenantId, requestLineId], references: [tenantId, id])
  item        Item                @relation(fields: [tenantId, itemId], references: [tenantId, id])
  itemUnit    ItemUnit?           @relation(fields: [tenantId, itemUnitId], references: [tenantId, id])
  taxCategory TaxCategory?        @relation(fields: [tenantId, taxCategoryId], references: [tenantId, id])
  orderLines  PurchaseOrderLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, quoteId, lineNo])
  @@map("purchase_quote_lines")
}

/// Purchase order to one supplier (ADR-025 §4, MEDIUM and FULL). Numbered PO at approval; no ledger or stock effect.
model PurchaseOrder {
  id               BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId         BigInt              @map("tenant_id") @db.UnsignedBigInt
  companyId        BigInt              @map("company_id") @db.UnsignedBigInt
  /// The receiving warehouse's branch (ADR-025 §12, ADR-003).
  branchId         BigInt?             @map("branch_id") @db.UnsignedBigInt
  orderNo          String?             @map("order_no") @db.VarChar(50)
  orderDate        DateTime            @map("order_date") @db.Date
  expectedDate     DateTime?           @map("expected_date") @db.Date
  supplierId       BigInt              @map("supplier_id") @db.UnsignedBigInt
  warehouseId      BigInt              @map("warehouse_id") @db.UnsignedBigInt
  /// ADR-025 §12: copied to the invoice in phase 13.
  costCenterId     BigInt?             @map("cost_center_id") @db.UnsignedBigInt
  /// The approved request it orders from (always at FULL, never at MEDIUM); set at creation only.
  requestId        BigInt?             @map("request_id") @db.UnsignedBigInt
  /// ADR-017: prices entered including tax (company setting when the draft was saved).
  pricesIncludeTax Boolean             @default(false) @map("prices_include_tax")
  status           PurchaseOrderStatus @default(DRAFT)
  notes            String?             @db.VarChar(500)
  netTotal         Decimal             @default(0) @map("net_total") @db.Decimal(18, 3)
  taxTotal         Decimal             @default(0) @map("tax_total") @db.Decimal(18, 3)
  grandTotal       Decimal             @default(0) @map("grand_total") @db.Decimal(18, 3)
  submittedAt      DateTime?           @map("submitted_at") @db.DateTime(3)
  submittedBy      BigInt?             @map("submitted_by") @db.UnsignedBigInt
  approvedAt       DateTime?           @map("approved_at") @db.DateTime(3)
  approvedBy       BigInt?             @map("approved_by") @db.UnsignedBigInt
  /// The last rejection (the order went back to DRAFT).
  rejectedAt       DateTime?           @map("rejected_at") @db.DateTime(3)
  rejectedBy       BigInt?             @map("rejected_by") @db.UnsignedBigInt
  rejectReason     String?             @map("reject_reason") @db.VarChar(500)
  cancelledAt      DateTime?           @map("cancelled_at") @db.DateTime(3)
  cancelledBy      BigInt?             @map("cancelled_by") @db.UnsignedBigInt
  cancelReason     String?             @map("cancel_reason") @db.VarChar(500)
  /// ADR-026 §6: closed by hand with a written reason; nothing is received after.
  closedAt         DateTime?           @map("closed_at") @db.DateTime(3)
  closedBy         BigInt?             @map("closed_by") @db.UnsignedBigInt
  closeReason      String?             @map("close_reason") @db.VarChar(500)
  createdAt        DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy        BigInt?             @map("created_by") @db.UnsignedBigInt
  updatedBy        BigInt?             @map("updated_by") @db.UnsignedBigInt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company    Company             @relation(fields: [tenantId, companyId], references: [tenantId, id])
  branch     Branch?             @relation(fields: [tenantId, branchId], references: [tenantId, id])
  supplier   Party               @relation(fields: [tenantId, supplierId], references: [tenantId, id])
  warehouse  Warehouse           @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  costCenter CostCenter?         @relation(fields: [tenantId, companyId, costCenterId], references: [tenantId, companyId, id])
  request    PurchaseRequest?    @relation(fields: [tenantId, requestId], references: [tenantId, id])
  lines      PurchaseOrderLine[]
  goodsNotes GoodsNote[]
  invoices   PurchaseInvoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, orderNo])
  @@index([tenantId, companyId, orderDate, id])
  @@index([tenantId, supplierId])
  @@index([tenantId, requestId])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

/// An ordered line; request_line_id when it orders part of a request line, quote_line_id when chosen from a quote.
model PurchaseOrderLine {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId       BigInt   @map("tenant_id") @db.UnsignedBigInt
  orderId        BigInt   @map("order_id") @db.UnsignedBigInt
  lineNo         Int      @map("line_no")
  requestLineId  BigInt?  @map("request_line_id") @db.UnsignedBigInt
  quoteLineId    BigInt?  @map("quote_line_id") @db.UnsignedBigInt
  itemId         BigInt   @map("item_id") @db.UnsignedBigInt
  itemUnitId     BigInt?  @map("item_unit_id") @db.UnsignedBigInt
  qty            Decimal  @db.Decimal(18, 6)
  qtyBase        Decimal  @map("qty_base") @db.Decimal(18, 6)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 6)
  discountPct    Decimal  @default(0) @map("discount_pct") @db.Decimal(9, 4)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 3)
  netAmount      Decimal  @map("net_amount") @db.Decimal(18, 3)
  taxCategoryId  BigInt?  @map("tax_category_id") @db.UnsignedBigInt
  taxRate        Decimal  @default(0) @map("tax_rate") @db.Decimal(9, 4)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 3)
  lineTotal      Decimal  @map("line_total") @db.Decimal(18, 3)
  note           String?  @db.VarChar(500)
  /// ADR-026 §5: base quantity received by posted GRNs; never above qty_base (§4).
  receivedQty    Decimal  @default(0) @map("received_qty") @db.Decimal(18, 6)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order       PurchaseOrder        @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  requestLine PurchaseRequestLine? @relation(fields: [tenantId, requestLineId], references: [tenantId, id])
  quoteLine   PurchaseQuoteLine?   @relation(fields: [tenantId, quoteLineId], references: [tenantId, id])
  item        Item                 @relation(fields: [tenantId, itemId], references: [tenantId, id])
  itemUnit    ItemUnit?            @relation(fields: [tenantId, itemUnitId], references: [tenantId, id])
  taxCategory TaxCategory?         @relation(fields: [tenantId, taxCategoryId], references: [tenantId, id])
  goodsNoteLines GoodsNoteLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, orderId, lineNo])
  @@index([tenantId, requestLineId])
  @@map("purchase_order_lines")
}

/// ADR-026 §7: an invoice line billing a GRN line of its purchase order. qty in base units;
/// cleared_value is the 2104 value the posting cleared (NULL on a draft).
model PurchaseInvoiceReceipt {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId      BigInt   @map("tenant_id") @db.UnsignedBigInt
  invoiceLineId BigInt   @map("invoice_line_id") @db.UnsignedBigInt
  grnLineId     BigInt   @map("grn_line_id") @db.UnsignedBigInt
  qty           Decimal  @db.Decimal(18, 6)
  clearedValue  Decimal? @map("cleared_value") @db.Decimal(18, 3)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceLine PurchaseInvoiceLine @relation(fields: [tenantId, invoiceLineId], references: [tenantId, id], onDelete: Cascade)
  grnLine     GoodsNoteLine       @relation(fields: [tenantId, grnLineId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, invoiceLineId, grnLineId])
  @@index([tenantId, grnLineId])
  @@map("purchase_invoice_receipts")
}

/// Issue request (ADR-026 §9, FULL only): a department asks the store for items. Numbered IRQ at approval.
model IssueRequest {
  id               BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId         BigInt             @map("tenant_id") @db.UnsignedBigInt
  companyId        BigInt             @map("company_id") @db.UnsignedBigInt
  /// The issuing warehouse's branch (ADR-003).
  branchId         BigInt?            @map("branch_id") @db.UnsignedBigInt
  requestNo        String?            @map("request_no") @db.VarChar(50)
  requestDate      DateTime           @map("request_date") @db.Date
  warehouseId      BigInt             @map("warehouse_id") @db.UnsignedBigInt
  /// The department (ADR-026 §8); copied to its issues.
  costCenterId     BigInt?            @map("cost_center_id") @db.UnsignedBigInt
  /// Expense account the issues debit; copied to its issues.
  expenseAccountId BigInt?            @map("expense_account_id") @db.UnsignedBigInt
  status           IssueRequestStatus @default(DRAFT)
  notes            String?            @db.VarChar(500)
  submittedAt      DateTime?          @map("submitted_at") @db.DateTime(3)
  submittedBy      BigInt?            @map("submitted_by") @db.UnsignedBigInt
  approvedAt       DateTime?          @map("approved_at") @db.DateTime(3)
  approvedBy       BigInt?            @map("approved_by") @db.UnsignedBigInt
  rejectedAt       DateTime?          @map("rejected_at") @db.DateTime(3)
  rejectedBy       BigInt?            @map("rejected_by") @db.UnsignedBigInt
  rejectReason     String?            @map("reject_reason") @db.VarChar(500)
  cancelledAt      DateTime?          @map("cancelled_at") @db.DateTime(3)
  cancelledBy      BigInt?            @map("cancelled_by") @db.UnsignedBigInt
  cancelReason     String?            @map("cancel_reason") @db.VarChar(500)
  closedAt         DateTime?          @map("closed_at") @db.DateTime(3)
  closedBy         BigInt?            @map("closed_by") @db.UnsignedBigInt
  createdAt        DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy        BigInt?            @map("created_by") @db.UnsignedBigInt
  updatedBy        BigInt?            @map("updated_by") @db.UnsignedBigInt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company        Company            @relation(fields: [tenantId, companyId], references: [tenantId, id])
  branch         Branch?            @relation(fields: [tenantId, branchId], references: [tenantId, id])
  warehouse      Warehouse          @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  costCenter     CostCenter?        @relation(fields: [tenantId, companyId, costCenterId], references: [tenantId, companyId, id])
  expenseAccount Account?           @relation("IssueRequestExpenseAccount", fields: [tenantId, companyId, expenseAccountId], references: [tenantId, companyId, id])
  lines          IssueRequestLine[]
  goodsNotes     GoodsNote[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, requestNo])
  // Lists: ORDER BY request_date DESC, id DESC.
  @@index([tenantId, companyId, requestDate, id])
  // Open-documents counter (ADR-026 §9).
  @@index([tenantId, status])
  @@map("issue_requests")
}

/// A requested item, in base units. issued_qty: base quantity issued by posted GINs.
model IssueRequestLine {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId  BigInt   @map("tenant_id") @db.UnsignedBigInt
  requestId BigInt   @map("request_id") @db.UnsignedBigInt
  lineNo    Int      @map("line_no")
  itemId    BigInt   @map("item_id") @db.UnsignedBigInt
  qty       Decimal  @db.Decimal(18, 6)
  issuedQty Decimal  @default(0) @map("issued_qty") @db.Decimal(18, 6)
  note      String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request        IssueRequest    @relation(fields: [tenantId, requestId], references: [tenantId, id], onDelete: Cascade)
  item           Item            @relation(fields: [tenantId, itemId], references: [tenantId, id])
  goodsNoteLines GoodsNoteLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, requestId, lineNo])
  @@map("issue_request_lines")
}

/// Sales quote (ADR-027 §2): DRAFT → SENT → ACCEPTED or REJECTED; CANCELLED from DRAFT or SENT. Numbered when sent.
enum SalesQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
}

/// Sales order (ADR-027 §3): DRAFT → (PENDING_APPROVAL) → CONFIRMED → PARTIALLY_INVOICED → INVOICED; CLOSED or CANCELLED. Numbered when confirmed.
enum SalesOrderStatus {
  DRAFT
  PENDING_APPROVAL
  CONFIRMED
  PARTIALLY_INVOICED
  INVOICED
  CLOSED
  CANCELLED
}

/// ADR-027 §5: stock reservation of confirmed orders (NONE hides it, SOFT shows it, HARD refuses).
enum SalesReservation {
  NONE
  SOFT
  HARD
}

/// ADR-027 §6: when a sales order needs approval before it is confirmed.
enum SalesOrderApproval {
  NONE
  OVER_CREDIT_LIMIT
  ALWAYS
}

/// Sales quotation to one customer (ADR-027 §2). No ledger or stock effect.
model SalesQuote {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId         BigInt           @map("tenant_id") @db.UnsignedBigInt
  companyId        BigInt           @map("company_id") @db.UnsignedBigInt
  /// The warehouse's branch when a warehouse is named (ADR-003).
  branchId         BigInt?          @map("branch_id") @db.UnsignedBigInt
  /// The warehouse the quote is for; the order takes its own at conversion.
  warehouseId      BigInt?          @map("warehouse_id") @db.UnsignedBigInt
  customerId       BigInt           @map("customer_id") @db.UnsignedBigInt
  costCenterId     BigInt?          @map("cost_center_id") @db.UnsignedBigInt
  quoteNo          String?          @map("quote_no") @db.VarChar(50)
  quoteDate        DateTime         @map("quote_date") @db.Date
  validUntil       DateTime?        @map("valid_until") @db.Date
  /// ADR-017: prices entered including tax (company setting when the draft was saved).
  pricesIncludeTax Boolean          @default(false) @map("prices_include_tax")
  status           SalesQuoteStatus @default(DRAFT)
  description      String?          @db.VarChar(500)
  netTotal         Decimal          @default(0) @map("net_total") @db.Decimal(18, 3)
  taxTotal         Decimal          @default(0) @map("tax_total") @db.Decimal(18, 3)
  grandTotal       Decimal          @default(0) @map("grand_total") @db.Decimal(18, 3)
  sentAt           DateTime?        @map("sent_at") @db.DateTime(3)
  sentBy           BigInt?          @map("sent_by") @db.UnsignedBigInt
  acceptedAt       DateTime?        @map("accepted_at") @db.DateTime(3)
  acceptedBy       BigInt?          @map("accepted_by") @db.UnsignedBigInt
  rejectedAt       DateTime?        @map("rejected_at") @db.DateTime(3)
  rejectedBy       BigInt?          @map("rejected_by") @db.UnsignedBigInt
  rejectReason     String?          @map("reject_reason") @db.VarChar(500)
  cancelledAt      DateTime?        @map("cancelled_at") @db.DateTime(3)
  cancelledBy      BigInt?          @map("cancelled_by") @db.UnsignedBigInt
  cancelReason     String?          @map("cancel_reason") @db.VarChar(500)
  createdAt        DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy        BigInt?          @map("created_by") @db.UnsignedBigInt
  updatedBy        BigInt?          @map("updated_by") @db.UnsignedBigInt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company    Company          @relation(fields: [tenantId, companyId], references: [tenantId, id])
  branch     Branch?          @relation(fields: [tenantId, branchId], references: [tenantId, id])
  warehouse  Warehouse?       @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  customer   Party            @relation(fields: [tenantId, customerId], references: [tenantId, id])
  costCenter CostCenter?      @relation(fields: [tenantId, companyId, costCenterId], references: [tenantId, companyId, id])
  lines      SalesQuoteLine[]
  orders     SalesOrder[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, quoteNo])
  @@index([tenantId, companyId, quoteDate, id])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("sales_quotes")
}

/// A quoted line; prices and amounts are computed by the server when the draft is saved.
model SalesQuoteLine {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId       BigInt   @map("tenant_id") @db.UnsignedBigInt
  quoteId        BigInt   @map("quote_id") @db.UnsignedBigInt
  lineNo         Int      @map("line_no")
  itemId         BigInt   @map("item_id") @db.UnsignedBigInt
  itemUnitId     BigInt?  @map("item_unit_id") @db.UnsignedBigInt
  qty            Decimal  @db.Decimal(18, 6)
  qtyBase        Decimal  @map("qty_base") @db.Decimal(18, 6)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 3)
  discountPct    Decimal  @default(0) @map("discount_pct") @db.Decimal(9, 4)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 3)
  netAmount      Decimal  @default(0) @map("net_amount") @db.Decimal(18, 3)
  taxCategoryId  BigInt?  @map("tax_category_id") @db.UnsignedBigInt
  taxRate        Decimal  @default(0) @map("tax_rate") @db.Decimal(9, 4)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 3)
  lineTotal      Decimal  @default(0) @map("line_total") @db.Decimal(18, 3)
  note           String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quote       SalesQuote      @relation(fields: [tenantId, quoteId], references: [tenantId, id], onDelete: Cascade)
  item        Item            @relation(fields: [tenantId, itemId], references: [tenantId, id])
  itemUnit    ItemUnit?       @relation(fields: [tenantId, itemUnitId], references: [tenantId, id])
  taxCategory TaxCategory?    @relation(fields: [tenantId, taxCategoryId], references: [tenantId, id])
  orderLines  SalesOrderLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, quoteId, lineNo])
  @@map("sales_quote_lines")
}

/// Sales order to one customer (ADR-027 §3). Numbered at confirmation; no ledger or stock effect (invoices bill it, §4).
model SalesOrder {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId         BigInt           @map("tenant_id") @db.UnsignedBigInt
  companyId        BigInt           @map("company_id") @db.UnsignedBigInt
  /// The warehouse's branch (ADR-003), as on the sales invoice.
  branchId         BigInt?          @map("branch_id") @db.UnsignedBigInt
  orderNo          String?          @map("order_no") @db.VarChar(50)
  orderDate        DateTime         @map("order_date") @db.Date
  expectedDate     DateTime?        @map("expected_date") @db.Date
  customerId       BigInt           @map("customer_id") @db.UnsignedBigInt
  warehouseId      BigInt           @map("warehouse_id") @db.UnsignedBigInt
  costCenterId     BigInt?          @map("cost_center_id") @db.UnsignedBigInt
  /// The quote it was converted from (once only, ADR-027 §2).
  salesQuoteId     BigInt?          @map("sales_quote_id") @db.UnsignedBigInt
  /// ADR-017: prices entered including tax (company setting when the draft was saved).
  pricesIncludeTax Boolean          @default(false) @map("prices_include_tax")
  paymentTermsDays Int?             @map("payment_terms_days")
  status           SalesOrderStatus @default(DRAFT)
  description      String?          @db.VarChar(500)
  netTotal         Decimal          @default(0) @map("net_total") @db.Decimal(18, 3)
  taxTotal         Decimal          @default(0) @map("tax_total") @db.Decimal(18, 3)
  grandTotal       Decimal          @default(0) @map("grand_total") @db.Decimal(18, 3)
  submittedAt      DateTime?        @map("submitted_at") @db.DateTime(3)
  submittedBy      BigInt?          @map("submitted_by") @db.UnsignedBigInt
  confirmedAt      DateTime?        @map("confirmed_at") @db.DateTime(3)
  confirmedBy      BigInt?          @map("confirmed_by") @db.UnsignedBigInt
  approvedAt       DateTime?        @map("approved_at") @db.DateTime(3)
  approvedBy       BigInt?          @map("approved_by") @db.UnsignedBigInt
  /// The last rejection of the approval (the order went back to DRAFT).
  rejectedAt       DateTime?        @map("rejected_at") @db.DateTime(3)
  rejectedBy       BigInt?          @map("rejected_by") @db.UnsignedBigInt
  rejectReason     String?          @map("reject_reason") @db.VarChar(500)
  cancelledAt      DateTime?        @map("cancelled_at") @db.DateTime(3)
  cancelledBy      BigInt?          @map("cancelled_by") @db.UnsignedBigInt
  cancelReason     String?          @map("cancel_reason") @db.VarChar(500)
  /// ADR-027 §3: closed by hand with a written reason, partly invoiced; its reservation is released.
  closedAt         DateTime?        @map("closed_at") @db.DateTime(3)
  closedBy         BigInt?          @map("closed_by") @db.UnsignedBigInt
  closeReason      String?          @map("close_reason") @db.VarChar(500)
  createdAt        DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy        BigInt?          @map("created_by") @db.UnsignedBigInt
  updatedBy        BigInt?          @map("updated_by") @db.UnsignedBigInt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company    Company          @relation(fields: [tenantId, companyId], references: [tenantId, id])
  branch     Branch?          @relation(fields: [tenantId, branchId], references: [tenantId, id])
  customer   Party            @relation(fields: [tenantId, customerId], references: [tenantId, id])
  warehouse  Warehouse        @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  costCenter CostCenter?      @relation(fields: [tenantId, companyId, costCenterId], references: [tenantId, companyId, id])
  quote      SalesQuote?      @relation(fields: [tenantId, salesQuoteId], references: [tenantId, id])
  lines      SalesOrderLine[]
  invoices   SalesInvoice[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, orderNo])
  // One order per quote (ADR-027 §2): a converted quote is not converted again.
  @@unique([tenantId, salesQuoteId])
  @@index([tenantId, companyId, orderDate, id])
  @@index([tenantId, customerId])
  @@index([tenantId, warehouseId, status])
  @@index([tenantId, status])
  @@map("sales_orders")
}

/// An ordered line. invoiced_qty (base units) is set by the posting of the invoices that bill it (ADR-027 §4).
model SalesOrderLine {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId       BigInt   @map("tenant_id") @db.UnsignedBigInt
  orderId        BigInt   @map("order_id") @db.UnsignedBigInt
  lineNo         Int      @map("line_no")
  quoteLineId    BigInt?  @map("quote_line_id") @db.UnsignedBigInt
  itemId         BigInt   @map("item_id") @db.UnsignedBigInt
  itemUnitId     BigInt?  @map("item_unit_id") @db.UnsignedBigInt
  qty            Decimal  @db.Decimal(18, 6)
  qtyBase        Decimal  @map("qty_base") @db.Decimal(18, 6)
  /// Base quantity billed by posted invoices; never above qty_base (ADR-027 §4).
  invoicedQty    Decimal  @default(0) @map("invoiced_qty") @db.Decimal(18, 6)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 3)
  discountPct    Decimal  @default(0) @map("discount_pct") @db.Decimal(9, 4)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 3)
  netAmount      Decimal  @default(0) @map("net_amount") @db.Decimal(18, 3)
  taxCategoryId  BigInt?  @map("tax_category_id") @db.UnsignedBigInt
  taxRate        Decimal  @default(0) @map("tax_rate") @db.Decimal(9, 4)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 3)
  lineTotal      Decimal  @default(0) @map("line_total") @db.Decimal(18, 3)
  note           String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order        SalesOrder          @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  quoteLine    SalesQuoteLine?     @relation(fields: [tenantId, quoteLineId], references: [tenantId, id])
  item         Item                @relation(fields: [tenantId, itemId], references: [tenantId, id])
  itemUnit     ItemUnit?           @relation(fields: [tenantId, itemUnitId], references: [tenantId, id])
  taxCategory  TaxCategory?        @relation(fields: [tenantId, taxCategoryId], references: [tenantId, id])
  invoiceLines SalesInvoiceLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, orderId, lineNo])
  // Reservations: open lines of one item (ADR-027 §5).
  @@index([tenantId, itemId])
  @@map("sales_order_lines")
}
