  unitPrice       Decimal  @map("unit_price") @db.Decimal(18, 3)
  discountPct     Decimal  @default(0) @map("discount_pct") @db.Decimal(9, 4)
  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(18, 3)
  netAmount       Decimal  @map("net_amount") @db.Decimal(18, 3)
  taxCategoryId   BigInt?  @map("tax_category_id") @db.UnsignedBigInt
  taxRate         Decimal  @default(0) @map("tax_rate") @db.Decimal(9, 4)
  taxAmount       Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 3)
  lineTotal       Decimal  @map("line_total") @db.Decimal(18, 3)
  unitCost        Decimal? @map("unit_cost") @db.Decimal(18, 6)
  costTotal       Decimal  @default(0) @map("cost_total") @db.Decimal(18, 3)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesReturn    SalesReturn     @relation(fields: [tenantId, returnId], references: [tenantId, id], onDelete: Cascade)
  originalLine   SalesInvoiceLine @relation(fields: [tenantId, originalLineId], references: [tenantId, id])
  item           Item            @relation(fields: [tenantId, itemId], references: [tenantId, id])
  taxCategory    TaxCategory?    @relation(fields: [tenantId, taxCategoryId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, returnId, lineNo])
  @@map("sales_return_lines")
}

