// ERP Cloud — Phase 1 schema (platform + tenant isolation).
// Conventions (docs/BUILD_PLAN.md §6):
//  - DB columns snake_case via @map/@@map; TS fields camelCase/PascalCase.
//  - Money DECIMAL(18,3), qty DECIMAL(18,6), ids BIGINT UNSIGNED.
//  - Tenant tables carry tenant_id + @@unique([tenantId, id]); cross-table
//    relations inside a tenant use composite FKs [tenantId, xId] -> [tenantId, id].
//  - Connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

/// How much of the purchasing cycle a company uses (ADR-013 §1, ADR-024 §2).
enum ProcurementLevel {
  SIMPLE
  MEDIUM
  FULL
}

enum CostingMethod {
  WEIGHTED_AVERAGE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum ControlType {
  CUSTOMERS
  SUPPLIERS
  CASH
  BANK
}

enum FiscalStatus {
  OPEN
  CLOSED
}

enum JournalPostingKind {
  POST
  REVERSAL
}

enum JournalEntryStatus {
  DRAFT
  POSTED
}

enum JournalPartyType {
  CUSTOMER
  SUPPLIER
}

enum JournalVoucherType {
  JOURNAL
  RECEIPT_VOUCHER
  PAYMENT_VOUCHER
}

enum ItemKind {
  STOCK
  SERVICE
}

enum StockMovementType {
  IN
  OUT
}

enum StockAdjustmentType {
  OPENING
  IN
  OUT
  COUNT_ADJUSTMENT
}

enum DocumentStatus {
  DRAFT
  POSTED
}

/// Purchase request (ADR-025 §7): DRAFT → SUBMITTED → APPROVED; ends REJECTED, CANCELLED or CLOSED.
enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  CLOSED
}

/// Request for quotation (ADR-025 §7): DRAFT → SENT → RECEIVED; ends CLOSED or CANCELLED.
enum PurchaseQuoteStatus {
  DRAFT
  SENT
  RECEIVED
  CLOSED
  CANCELLED
}

/// Purchase order (ADR-025 §7, ADR-026 §6): DRAFT → SUBMITTED → APPROVED → PARTIALLY_RECEIVED → RECEIVED;
/// CLOSED by hand (approved or partly received), CANCELLED while nothing is received.
enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  CANCELLED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
}

/// Issue request (ADR-026 §9, FULL only): DRAFT → SUBMITTED → APPROVED; ends REJECTED, CANCELLED or CLOSED.
enum IssueRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  CLOSED
}

// ---------------------------------------------------------------------------
// Platform (non-tenant) tables
// ---------------------------------------------------------------------------

model Plan {
  id                  BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code                String   @unique @db.VarChar(50)
  nameAr              String   @map("name_ar") @db.VarChar(191)
  nameEn              String?  @map("name_en") @db.VarChar(191)
  maxUsers            Int      @map("max_users")
  maxBranches         Int      @map("max_branches")
  maxWarehouses       Int      @map("max_warehouses")
  maxInvoicesPerMonth Int      @map("max_invoices_per_month")
  priceMonthly        Decimal? @map("price_monthly") @db.Decimal(18, 3)
  priceYearly         Decimal? @map("price_yearly") @db.Decimal(18, 3)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenants       Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model Currency {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code          String   @unique @db.VarChar(10)
  nameAr        String   @map("name_ar") @db.VarChar(191)
  nameEn        String?  @map("name_en") @db.VarChar(191)
  symbol        String?  @db.VarChar(10)
  decimalPlaces Int      @default(3) @map("decimal_places")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  companiesAsBase Company[] @relation("CompanyBaseCurrency")

  @@map("currencies")
}

model Role {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code        String   @unique @db.VarChar(50)
  nameAr      String   @map("name_ar") @db.VarChar(191)
  nameEn      String?  @map("name_en") @db.VarChar(191)
  description String?  @db.Text
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  permissions RolePermission[]
  memberships TenantMembership[]

  @@map("roles")
}

model RolePermission {
  id             BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  roleId         BigInt @map("role_id") @db.UnsignedBigInt
  permissionCode String @map("permission_code") @db.VarChar(100)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionCode])
  @@index([permissionCode])
  @@map("role_permissions")
}

model Country {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code      String   @unique @db.VarChar(10)
  nameAr    String   @map("name_ar") @db.VarChar(191)
  nameEn    String?  @map("name_en") @db.VarChar(191)
  phoneCode String?  @map("phone_code") @db.VarChar(10)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("countries")
}

model User {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  email           String    @unique @db.VarChar(191)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(191)
  locale          String    @default("ar") @db.VarChar(10)
  isActive        Boolean   @default(true) @map("is_active")
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime? @map("last_login_at") @db.DateTime(3)
  /// Set for a temporary password (invite without a password, or a reset): the
  /// user may only change the password until this is cleared (AuthGuard).
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  memberships   TenantMembership[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId       BigInt    @map("user_id") @db.UnsignedBigInt
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  familyId     String    @map("family_id") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt    DateTime? @map("revoked_at") @db.DateTime(3)
  replacedById BigInt?   @map("replaced_by_id") @db.UnsignedBigInt
  tenantId     BigInt?   @map("tenant_id") @db.UnsignedBigInt
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ip           String?   @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken?  @relation("TokenRotation", fields: [replacedById], references: [id])
  replaces   RefreshToken[] @relation("TokenRotation")

  @@index([userId])
  @@index([familyId])
  // The purge job deletes by expiry (DB-12).
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Tenant-scoped tables
// ---------------------------------------------------------------------------

model Tenant {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  name        String       @db.VarChar(191)
  status      TenantStatus @default(TRIAL)
  planId      BigInt?      @map("plan_id") @db.UnsignedBigInt
  trialEndsAt DateTime?    @map("trial_ends_at") @db.DateTime(3)
  /// Last status change (ADR-009): grace and post-cancellation retention count from it.
  statusChangedAt DateTime? @map("status_changed_at") @db.DateTime(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  plan                 Plan?                 @relation(fields: [planId], references: [id])
  subscriptions        Subscription[]
  companies            Company[]
  branches             Branch[]
  memberships          TenantMembership[]
  auditLogs            AuditLog[]
  attachments          Attachment[]
  idempotencyKeys      IdempotencyKey[]
  units                Unit[]
  taxCategories        TaxCategory[]
  paymentMethods       PaymentMethod[]
  fiscalYears          FiscalYear[]
  accounts             Account[]
  documentSequences    DocumentSequence[]
  journalEntries       JournalEntry[]
  journalLines         JournalLine[]
  itemGroups           ItemGroup[]
  items                Item[]
  warehouses           Warehouse[]
  stockMovements       StockMovement[]
  stockBalances        StockBalance[]
  itemCosts            ItemCost[]
  stockAdjustments     StockAdjustment[]
  stockTransfers       StockTransfer[]
  stockCounts          StockCount[]
  itemUnits            ItemUnit[]
  itemBarcodes         ItemBarcode[]
  stockAdjustmentLines StockAdjustmentLine[]
  stockTransferLines   StockTransferLine[]
  stockCountLines      StockCountLine[]
  parties              Party[]
  costCenters          CostCenter[]
  cashBoxes            CashBox[]
  bankAccounts         BankAccount[]
  salesInvoices        SalesInvoice[]
  salesInvoiceLines    SalesInvoiceLine[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  salesReturns         SalesReturn[]
  salesReturnLines     SalesReturnLine[]
  purchaseReturns      PurchaseReturn[]
  purchaseReturnLines  PurchaseReturnLine[]
  goodsNotes           GoodsNote[]
  goodsNoteLines       GoodsNoteLine[]
  receipts             Receipt[]
  payments             Payment[]
  cashTransfers        CashTransfer[]
  einvoiceSettings     EInvoiceSettings[]
  einvoiceSubmissions  EInvoiceSubmission[]
  einvoiceAttempts     EInvoiceAttempt[]
  allocations          Allocation[]
  purchaseRequests     PurchaseRequest[]
  purchaseRequestLines PurchaseRequestLine[]
  purchaseQuotes       PurchaseQuote[]
  purchaseQuoteLines   PurchaseQuoteLine[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderLines   PurchaseOrderLine[]
  purchaseInvoiceReceipts PurchaseInvoiceReceipt[]
  issueRequests        IssueRequest[]
  issueRequestLines    IssueRequestLine[]

  @@map("tenants")
  salesQuotes SalesQuote[]
  salesQuoteLines SalesQuoteLine[]
  salesOrders SalesOrder[]
  salesOrderLines SalesOrderLine[]
}

model Subscription {
  id          BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId    BigInt             @map("tenant_id") @db.UnsignedBigInt
  planId      BigInt             @map("plan_id") @db.UnsignedBigInt
  periodStart DateTime           @map("period_start") @db.Date
  periodEnd   DateTime           @map("period_end") @db.Date
  status      SubscriptionStatus @default(ACTIVE)
  amount      Decimal?           @db.Decimal(18, 3)
  notes       String?            @db.Text
  createdAt   DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("subscriptions")
}

model Company {
  id                     BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId               BigInt        @map("tenant_id") @db.UnsignedBigInt
  legalNameAr            String        @map("legal_name_ar") @db.VarChar(191)
  legalNameEn            String?       @map("legal_name_en") @db.VarChar(191)
  taxNumber              String?       @map("tax_number") @db.VarChar(50)
  commercialRegistration String?       @map("commercial_registration") @db.VarChar(100)
  address                String?       @db.VarChar(512)
  phone                  String?       @db.VarChar(50)
  logoAttachmentId       BigInt?       @map("logo_attachment_id") @db.UnsignedBigInt
  baseCurrencyId         BigInt?       @map("base_currency_id") @db.UnsignedBigInt
  timezone               String        @default("Asia/Amman") @db.VarChar(64)
  costingMethod          CostingMethod @default(WEIGHTED_AVERAGE) @map("costing_method")
  allowNegativeStock     Boolean       @default(false) @map("allow_negative_stock")
  pricesIncludeTax       Boolean       @default(false) @map("prices_include_tax")
  /// ADR-024 §1: cost centres shown and enforced. Off hides them; posted lines keep theirs.
  costCentersEnabled     Boolean       @default(false) @map("cost_centers_enabled")
  /// Set when the owner finishes the setup wizard (§13.4, ADR-009).
  onboardingCompletedAt  DateTime?     @map("onboarding_completed_at") @db.DateTime(3)
  /// Purchasing cycle level (ADR-024 §2): raised any time, lowered only with no open cycle documents.
  procurementLevel       ProcurementLevel @default(SIMPLE) @map("procurement_level")
  /// Sales cycle settings (ADR-027 §1): a sales invoice must come from a confirmed order when on.
  salesOrderRequired     Boolean          @default(false) @map("sales_order_required")
  /// ADR-027 §5: NONE hides reservations, SOFT shows them, HARD refuses over-reserving.
  salesReservation       SalesReservation @default(SOFT) @map("sales_reservation")
  /// ADR-027 §6: when a sales order needs approval before it is confirmed.
  salesOrderApproval     SalesOrderApproval @default(OVER_CREDIT_LIMIT) @map("sales_order_approval")
  /// ADR-027 §4: the invoice price and discount may not go below the order without approval.
  salesPriceLocked       Boolean          @default(false) @map("sales_price_locked")
  /// Default validity of a new quote in days; 0 = no default expiry (ADR-027 §1).
  quoteValidityDays      Int              @default(30) @map("quote_validity_days")
  isActive              Boolean       @default(true) @map("is_active")
  createdAt              DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy              BigInt?       @map("created_by") @db.UnsignedBigInt
  updatedBy              BigInt?       @map("updated_by") @db.UnsignedBigInt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseCurrency      Currency?          @relation("CompanyBaseCurrency", fields: [baseCurrencyId], references: [id])
  logoAttachment    Attachment?        @relation("CompanyLogo", fields: [tenantId, logoAttachmentId], references: [tenantId, id])
  branches          Branch[]
  fiscalYears       FiscalYear[]
  accounts          Account[]
  accountMappings   AccountMapping[]
  documentSequences DocumentSequence[]
  journalEntries    JournalEntry[]
  items             Item[]
  warehouses        Warehouse[]
  stockMovements    StockMovement[]
  itemCosts         ItemCost[]
  stockAdjustments  StockAdjustment[]
  stockTransfers    StockTransfer[]
  stockCounts       StockCount[]
  parties           Party[]
  cashBoxes         CashBox[]
  bankAccounts      BankAccount[]
  salesInvoices     SalesInvoice[]
  purchaseInvoices  PurchaseInvoice[]
  salesReturns      SalesReturn[]
  purchaseReturns   PurchaseReturn[]
  goodsNotes        GoodsNote[]
  receipts          Receipt[]
  payments          Payment[]
  cashTransfers        CashTransfer[]
  einvoiceSettings     EInvoiceSettings[]
  einvoiceSubmissions  EInvoiceSubmission[]
  allocations       Allocation[]
  costCenters       CostCenter[]
  purchaseRequests  PurchaseRequest[]
  purchaseQuotes    PurchaseQuote[]
  purchaseOrders    PurchaseOrder[]
  issueRequests     IssueRequest[]
  salesQuotes       SalesQuote[]
  salesOrders       SalesOrder[]

  @@unique([tenantId, id])
  @@map("companies")
}

model Branch {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId  BigInt   @map("tenant_id") @db.UnsignedBigInt
  companyId BigInt   @map("company_id") @db.UnsignedBigInt
  code      String   @db.VarChar(50)
  nameAr    String   @map("name_ar") @db.VarChar(191)
  nameEn    String?  @map("name_en") @db.VarChar(191)
  address   String?  @db.VarChar(512)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy BigInt?  @map("created_by") @db.UnsignedBigInt
  updatedBy BigInt?  @map("updated_by") @db.UnsignedBigInt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company            Company            @relation(fields: [tenantId, companyId], references: [tenantId, id])
  memberships        TenantMembership[] @relation("MembershipDefaultBranch")
  membershipBranches MembershipBranch[]
  journalEntries     JournalEntry[]
  warehouses         Warehouse[]
  goodsNotes         GoodsNote[]
  einvoiceSubmissions EInvoiceSubmission[]
  purchaseRequests   PurchaseRequest[]
  purchaseQuotes     PurchaseQuote[]
  purchaseOrders     PurchaseOrder[]
  issueRequests      IssueRequest[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, code])
  @@map("branches")
  salesQuotes SalesQuote[]
  salesOrders SalesOrder[]
}

model TenantMembership {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId        BigInt           @map("tenant_id") @db.UnsignedBigInt
  userId          BigInt           @map("user_id") @db.UnsignedBigInt
  roleId          BigInt           @map("role_id") @db.UnsignedBigInt
  status          MembershipStatus @default(INVITED)
  defaultBranchId BigInt?          @map("default_branch_id") @db.UnsignedBigInt
  invitedBy       BigInt?          @map("invited_by") @db.UnsignedBigInt
  // Invitation acceptance code (ADR-012, PLAT-10): sha256 of the one-time code
  // the inviting admin hands over; never the code itself.
  inviteCodeHash      String?   @map("invite_code_hash") @db.Char(64)
  inviteCodeExpiresAt DateTime? @map("invite_code_expires_at") @db.DateTime(3)
  inviteCodeAttempts  Int       @default(0) @map("invite_code_attempts")
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role               @relation(fields: [roleId], references: [id])
  defaultBranch   Branch?            @relation("MembershipDefaultBranch", fields: [tenantId, defaultBranchId], references: [tenantId, id])
  allowedBranches MembershipBranch[]
  extraPermissions MemberPermission[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@map("tenant_memberships")
}

model MembershipBranch {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId     BigInt   @map("tenant_id") @db.UnsignedBigInt
  membershipId BigInt   @map("membership_id") @db.UnsignedBigInt
  branchId     BigInt   @map("branch_id") @db.UnsignedBigInt
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  branch     Branch           @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@unique([tenantId, membershipId, branchId])
  @@map("membership_branches")
}

/// Purchase permissions granted to one member on top of the role (ADR-013 §2,
/// ADR-024 §3): purchase.direct, purchase.approve (with an optional amount
/// limit) and stock.issue_without_request. Only an owner grants them.
model MemberPermission {
  id             BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId       BigInt   @map("tenant_id") @db.UnsignedBigInt
  membershipId   BigInt   @map("membership_id") @db.UnsignedBigInt
  permissionCode String   @map("permission_code") @db.VarChar(100)
  /// purchase.approve only: the highest amount this member approves alone; null = no limit.
  amountLimit    Decimal? @map("amount_limit") @db.Decimal(18, 3)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, membershipId, permissionCode])
  @@map("member_permissions")
}

/// Where an error came from (ADR-010 §10.3).
enum ErrorSource {
  API
  WEB
  JOB
}

/// Errors for the platform console (ADR-010 §10.3): server 500s, errors in the
/// web app, failed Cron commands. One row per kind of error (fingerprint),
/// counted and dated. Platform-level like audit_logs: tenant_id / user_id are
/// context of the last occurrence only (no relation, not tenant-scoped); the
/// purge job removes a tenant's rows with its other tables. Text is redacted
/// (passwords, tokens) before it is stored.
model ErrorEvent {
  id          BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  fingerprint String      @unique @db.Char(64)
  source      ErrorSource
  name        String      @db.VarChar(191)
  message     String      @db.VarChar(1000)
  stack       String?     @db.Text
  method      String?     @db.VarChar(10)
  path        String?     @db.VarChar(500)
  status      Int?
  tenantId    BigInt?     @map("tenant_id") @db.UnsignedBigInt
  userId      BigInt?     @map("user_id") @db.UnsignedBigInt
  requestId   String?     @map("request_id") @db.VarChar(64)
  count       Int         @default(1)
  firstSeenAt DateTime    @default(now()) @map("first_seen_at") @db.DateTime(3)
  lastSeenAt  DateTime    @default(now()) @map("last_seen_at") @db.DateTime(3)
  /// Set from the console; a new occurrence reopens it.
  resolvedAt  DateTime?   @map("resolved_at") @db.DateTime(3)
  /// Last alert sent for it (error-digest); a later occurrence alerts again.
  notifiedAt  DateTime?   @map("notified_at") @db.DateTime(3)

  @@index([resolvedAt, lastSeenAt])
  @@map("error_events")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId   BigInt?  @map("tenant_id") @db.UnsignedBigInt
  userId     BigInt?  @map("user_id") @db.UnsignedBigInt
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  // Tenant first: a reader by entity must never search across tenants (DB-21).
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

model Attachment {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId   BigInt   @map("tenant_id") @db.UnsignedBigInt
  storageKey String   @map("storage_key") @db.VarChar(512)
