// ERP Cloud — Phase 1 schema (platform + tenant isolation).
// Conventions (docs/BUILD_PLAN.md §6):
//  - DB columns snake_case via @map/@@map; TS fields camelCase/PascalCase.
//  - Money DECIMAL(18,3), qty DECIMAL(18,6), ids BIGINT UNSIGNED.
//  - Tenant tables carry tenant_id + @@unique([tenantId, id]); cross-table
//    relations inside a tenant use composite FKs [tenantId, xId] -> [tenantId, id].
//  - Connection URL lives in prisma.config.ts (Prisma 7).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum CostingMethod {
  WEIGHTED_AVERAGE
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum NormalBalance {
  DEBIT
  CREDIT
}

enum ControlType {
  CUSTOMERS
  SUPPLIERS
  CASH
  BANK
}

enum FiscalStatus {
  OPEN
  CLOSED
}

enum JournalPostingKind {
  POST
  REVERSAL
}

enum JournalEntryStatus {
  DRAFT
  POSTED
}

enum JournalPartyType {
  CUSTOMER
  SUPPLIER
}

enum JournalVoucherType {
  JOURNAL
  RECEIPT_VOUCHER
  PAYMENT_VOUCHER
}

enum ItemKind {
  STOCK
  SERVICE
}

enum StockMovementType {
  IN
  OUT
}

enum StockAdjustmentType {
  OPENING
  IN
  OUT
  COUNT_ADJUSTMENT
}

enum DocumentStatus {
  DRAFT
  POSTED
}

// ---------------------------------------------------------------------------
// Platform (non-tenant) tables
// ---------------------------------------------------------------------------

model Plan {
  id                  BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code                String   @unique @db.VarChar(50)
  nameAr              String   @map("name_ar") @db.VarChar(191)
  nameEn              String?  @map("name_en") @db.VarChar(191)
  maxUsers            Int      @map("max_users")
  maxBranches         Int      @map("max_branches")
  maxWarehouses       Int      @map("max_warehouses")
  maxInvoicesPerMonth Int      @map("max_invoices_per_month")
  priceMonthly        Decimal? @map("price_monthly") @db.Decimal(18, 3)
  priceYearly         Decimal? @map("price_yearly") @db.Decimal(18, 3)
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenants       Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model Currency {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code          String   @unique @db.VarChar(10)
  nameAr        String   @map("name_ar") @db.VarChar(191)
  nameEn        String?  @map("name_en") @db.VarChar(191)
  symbol        String?  @db.VarChar(10)
  decimalPlaces Int      @default(3) @map("decimal_places")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  companiesAsBase Company[] @relation("CompanyBaseCurrency")

  @@map("currencies")
}

model Role {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code        String   @unique @db.VarChar(50)
  nameAr      String   @map("name_ar") @db.VarChar(191)
  nameEn      String?  @map("name_en") @db.VarChar(191)
  description String?  @db.Text
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  permissions RolePermission[]
  memberships TenantMembership[]

  @@map("roles")
}

model RolePermission {
  id             BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  roleId         BigInt @map("role_id") @db.UnsignedBigInt
  permissionCode String @map("permission_code") @db.VarChar(100)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionCode])
  @@index([permissionCode])
  @@map("role_permissions")
}

model Country {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code      String   @unique @db.VarChar(10)
  nameAr    String   @map("name_ar") @db.VarChar(191)
  nameEn    String?  @map("name_en") @db.VarChar(191)
  phoneCode String?  @map("phone_code") @db.VarChar(10)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("countries")
}

model User {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  email           String    @unique @db.VarChar(191)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  fullName        String    @map("full_name") @db.VarChar(191)
  locale          String    @default("ar") @db.VarChar(10)
  isActive        Boolean   @default(true) @map("is_active")
  isPlatformAdmin Boolean   @default(false) @map("is_platform_admin")
  lastLoginAt     DateTime? @map("last_login_at") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  memberships   TenantMembership[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id           BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId       BigInt    @map("user_id") @db.UnsignedBigInt
  tokenHash    String    @unique @map("token_hash") @db.VarChar(255)
  familyId     String    @map("family_id") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt    DateTime? @map("revoked_at") @db.DateTime(3)
  replacedById BigInt?   @map("replaced_by_id") @db.UnsignedBigInt
  tenantId     BigInt?   @map("tenant_id") @db.UnsignedBigInt
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ip           String?   @db.VarChar(64)
  createdAt    DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken?  @relation("TokenRotation", fields: [replacedById], references: [id])
  replaces   RefreshToken[] @relation("TokenRotation")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Tenant-scoped tables
// ---------------------------------------------------------------------------

model Tenant {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  name        String       @db.VarChar(191)
  status      TenantStatus @default(TRIAL)
  planId      BigInt?      @map("plan_id") @db.UnsignedBigInt
  trialEndsAt DateTime?    @map("trial_ends_at") @db.DateTime(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  plan                 Plan?                 @relation(fields: [planId], references: [id])
  subscriptions        Subscription[]
  companies            Company[]
  branches             Branch[]
  memberships          TenantMembership[]
  auditLogs            AuditLog[]
  attachments          Attachment[]
  idempotencyKeys      IdempotencyKey[]
  units                Unit[]
  taxCategories        TaxCategory[]
  paymentMethods       PaymentMethod[]
  fiscalYears          FiscalYear[]
  accounts             Account[]
  documentSequences    DocumentSequence[]
  journalEntries       JournalEntry[]
  journalLines         JournalLine[]
  itemGroups           ItemGroup[]
  items                Item[]
  warehouses           Warehouse[]
  stockMovements       StockMovement[]
  stockBalances        StockBalance[]
  itemCosts            ItemCost[]
  stockAdjustments     StockAdjustment[]
  stockTransfers       StockTransfer[]
  stockCounts          StockCount[]
  itemUnits            ItemUnit[]
  itemBarcodes         ItemBarcode[]
  stockAdjustmentLines StockAdjustmentLine[]
  stockTransferLines   StockTransferLine[]
  stockCountLines      StockCountLine[]

  @@map("tenants")
}

model Subscription {
  id          BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId    BigInt             @map("tenant_id") @db.UnsignedBigInt
  planId      BigInt             @map("plan_id") @db.UnsignedBigInt
  periodStart DateTime           @map("period_start") @db.Date
  periodEnd   DateTime           @map("period_end") @db.Date
  status      SubscriptionStatus @default(ACTIVE)
  amount      Decimal?           @db.Decimal(18, 3)
  notes       String?            @db.Text
  createdAt   DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan   Plan   @relation(fields: [planId], references: [id])

  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@map("subscriptions")
}

model Company {
  id                     BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId               BigInt        @map("tenant_id") @db.UnsignedBigInt
  legalNameAr            String        @map("legal_name_ar") @db.VarChar(191)
  legalNameEn            String?       @map("legal_name_en") @db.VarChar(191)
  taxNumber              String?       @map("tax_number") @db.VarChar(50)
  commercialRegistration String?       @map("commercial_registration") @db.VarChar(100)
  address                String?       @db.VarChar(512)
  phone                  String?       @db.VarChar(50)
  logoAttachmentId       BigInt?       @map("logo_attachment_id") @db.UnsignedBigInt
  baseCurrencyId         BigInt?       @map("base_currency_id") @db.UnsignedBigInt
  timezone               String        @default("Asia/Amman") @db.VarChar(64)
  costingMethod          CostingMethod @default(WEIGHTED_AVERAGE) @map("costing_method")
  allowNegativeStock     Boolean       @default(false) @map("allow_negative_stock")
  pricesIncludeTax       Boolean       @default(false) @map("prices_include_tax")
  isActive               Boolean       @default(true) @map("is_active")
  createdAt              DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy              BigInt?       @map("created_by") @db.UnsignedBigInt
  updatedBy              BigInt?       @map("updated_by") @db.UnsignedBigInt

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  baseCurrency      Currency?          @relation("CompanyBaseCurrency", fields: [baseCurrencyId], references: [id])
  logoAttachment    Attachment?        @relation("CompanyLogo", fields: [tenantId, logoAttachmentId], references: [tenantId, id])
  branches          Branch[]
  fiscalYears       FiscalYear[]
  accounts          Account[]
  accountMappings   AccountMapping[]
  documentSequences DocumentSequence[]
  journalEntries    JournalEntry[]
  items             Item[]
  warehouses        Warehouse[]
  stockMovements    StockMovement[]
  itemCosts         ItemCost[]
  stockAdjustments  StockAdjustment[]
  stockTransfers    StockTransfer[]
  stockCounts       StockCount[]

  @@unique([tenantId, id])
  @@map("companies")
}

model Branch {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId  BigInt   @map("tenant_id") @db.UnsignedBigInt
  companyId BigInt   @map("company_id") @db.UnsignedBigInt
  code      String   @db.VarChar(50)
  nameAr    String   @map("name_ar") @db.VarChar(191)
  nameEn    String?  @map("name_en") @db.VarChar(191)
  address   String?  @db.VarChar(512)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy BigInt?  @map("created_by") @db.UnsignedBigInt
  updatedBy BigInt?  @map("updated_by") @db.UnsignedBigInt

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company            Company            @relation(fields: [tenantId, companyId], references: [tenantId, id])
  memberships        TenantMembership[] @relation("MembershipDefaultBranch")
  membershipBranches MembershipBranch[]
  journalEntries     JournalEntry[]
  warehouses         Warehouse[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, code])
  @@map("branches")
}

model TenantMembership {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId        BigInt           @map("tenant_id") @db.UnsignedBigInt
  userId          BigInt           @map("user_id") @db.UnsignedBigInt
  roleId          BigInt           @map("role_id") @db.UnsignedBigInt
  status          MembershipStatus @default(INVITED)
  defaultBranchId BigInt?          @map("default_branch_id") @db.UnsignedBigInt
  invitedBy       BigInt?          @map("invited_by") @db.UnsignedBigInt
  createdAt       DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.DateTime(3)

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role            Role               @relation(fields: [roleId], references: [id])
  defaultBranch   Branch?            @relation("MembershipDefaultBranch", fields: [tenantId, defaultBranchId], references: [tenantId, id])
  allowedBranches MembershipBranch[]

  @@unique([tenantId, id])
  @@unique([tenantId, userId])
  @@map("tenant_memberships")
}

model MembershipBranch {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId     BigInt   @map("tenant_id") @db.UnsignedBigInt
  membershipId BigInt   @map("membership_id") @db.UnsignedBigInt
  branchId     BigInt   @map("branch_id") @db.UnsignedBigInt
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Cascade)
  branch     Branch           @relation(fields: [tenantId, branchId], references: [tenantId, id])

  @@unique([tenantId, membershipId, branchId])
  @@map("membership_branches")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId   BigInt?  @map("tenant_id") @db.UnsignedBigInt
  userId     BigInt?  @map("user_id") @db.UnsignedBigInt
  action     String   @db.VarChar(100)
  entityType String?  @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(512)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Attachment {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId   BigInt   @map("tenant_id") @db.UnsignedBigInt
  storageKey String   @map("storage_key") @db.VarChar(512)
  fileName   String   @map("file_name") @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(127)
  sizeBytes  BigInt?  @map("size_bytes") @db.UnsignedBigInt
  uploadedBy BigInt?  @map("uploaded_by") @db.UnsignedBigInt
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  companiesLogo Company[] @relation("CompanyLogo")

  @@unique([tenantId, id])
  @@map("attachments")
}

model IdempotencyKey {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId     BigInt   @map("tenant_id") @db.UnsignedBigInt
  key          String   @db.VarChar(255)
  endpoint     String   @db.VarChar(255)
  requestHash  String   @map("request_hash") @db.VarChar(64)
  status       String   @db.VarChar(20) // IN_PROGRESS | COMPLETED
  responseJson Json?    @map("response_json")
  httpStatus   Int?     @map("http_status")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt    DateTime @map("expires_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Phase 2 — financial setup & chart of accounts
// ---------------------------------------------------------------------------

model Unit {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId  BigInt   @map("tenant_id") @db.UnsignedBigInt
  code      String   @db.VarChar(50)
  nameAr    String   @map("name_ar") @db.VarChar(191)
  nameEn    String?  @map("name_en") @db.VarChar(191)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  itemsBase Item[]     @relation("ItemBaseUnit")
  itemUnits ItemUnit[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("units")
}

model TaxCategory {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId     BigInt   @map("tenant_id") @db.UnsignedBigInt
  code         String   @db.VarChar(50)
  nameAr       String   @map("name_ar") @db.VarChar(191)
  nameEn       String?  @map("name_en") @db.VarChar(191)
  rate         Decimal  @db.Decimal(9, 4)
  einvoiceCode String?  @map("einvoice_code") @db.VarChar(50)
  isDefault    Boolean  @default(false) @map("is_default")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  items Item[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("tax_categories")
}

model PaymentMethod {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId  BigInt   @map("tenant_id") @db.UnsignedBigInt
  code      String   @db.VarChar(50)
  nameAr    String   @map("name_ar") @db.VarChar(191)
  nameEn    String?  @map("name_en") @db.VarChar(191)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("payment_methods")
}

model FiscalYear {
  id        BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId  BigInt       @map("tenant_id") @db.UnsignedBigInt
  companyId BigInt       @map("company_id") @db.UnsignedBigInt
  code      String       @db.VarChar(20)
  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  status    FiscalStatus @default(OPEN)
  createdAt DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy BigInt?      @map("created_by") @db.UnsignedBigInt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company   Company            @relation(fields: [tenantId, companyId], references: [tenantId, id])
  periods   FiscalPeriod[]
  sequences DocumentSequence[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, code])
  @@map("fiscal_years")
}

model FiscalPeriod {
  id           BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId     BigInt       @map("tenant_id") @db.UnsignedBigInt
  fiscalYearId BigInt       @map("fiscal_year_id") @db.UnsignedBigInt
  periodNo     Int          @map("period_no")
  startDate    DateTime     @map("start_date") @db.Date
  endDate      DateTime     @map("end_date") @db.Date
  status       FiscalStatus @default(OPEN)
  closedAt     DateTime?    @map("closed_at") @db.DateTime(3)
  closedBy     BigInt?      @map("closed_by") @db.UnsignedBigInt
  createdAt    DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.DateTime(3)

  fiscalYear     FiscalYear     @relation(fields: [tenantId, fiscalYearId], references: [tenantId, id], onDelete: Cascade)
  journalEntries JournalEntry[]

  @@unique([tenantId, id])
  @@unique([tenantId, fiscalYearId, periodNo])
  @@map("fiscal_periods")
}

model Account {
  id            BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId      BigInt        @map("tenant_id") @db.UnsignedBigInt
  companyId     BigInt        @map("company_id") @db.UnsignedBigInt
  code          String        @db.VarChar(50)
  nameAr        String        @map("name_ar") @db.VarChar(191)
  nameEn        String?       @map("name_en") @db.VarChar(191)
  parentId      BigInt?       @map("parent_id") @db.UnsignedBigInt
  level         Int
  accountType   AccountType   @map("account_type")
  normalBalance NormalBalance @map("normal_balance")
  isPostable    Boolean       @default(true) @map("is_postable")
  isControl     Boolean       @default(false) @map("is_control")
  controlType   ControlType?  @map("control_type")
  isActive      Boolean       @default(true) @map("is_active")
  createdAt     DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy     BigInt?       @map("created_by") @db.UnsignedBigInt
  updatedBy     BigInt?       @map("updated_by") @db.UnsignedBigInt

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company      Company          @relation(fields: [tenantId, companyId], references: [tenantId, id])
  parent       Account?         @relation("AccountTree", fields: [tenantId, companyId, parentId], references: [tenantId, companyId, id])
  children     Account[]        @relation("AccountTree")
  mappings     AccountMapping[]
  journalLines JournalLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, id])
  @@unique([tenantId, companyId, code])
  @@map("accounts")
}

model AccountMapping {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId   BigInt   @map("tenant_id") @db.UnsignedBigInt
  companyId  BigInt   @map("company_id") @db.UnsignedBigInt
  mappingKey String   @map("mapping_key") @db.VarChar(100)
  accountId  BigInt   @map("account_id") @db.UnsignedBigInt
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  company Company @relation(fields: [tenantId, companyId], references: [tenantId, id])
  account Account @relation(fields: [tenantId, companyId, accountId], references: [tenantId, companyId, id])

  @@unique([tenantId, companyId, mappingKey])
  @@map("account_mappings")
}

model DocumentSequence {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId     BigInt   @map("tenant_id") @db.UnsignedBigInt
  companyId    BigInt   @map("company_id") @db.UnsignedBigInt
  documentType String   @map("document_type") @db.VarChar(50)
  fiscalYearId BigInt   @map("fiscal_year_id") @db.UnsignedBigInt
  prefix       String   @db.VarChar(20)
  nextNumber   Int      @default(1) @map("next_number")
  padding      Int      @default(6)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [tenantId, companyId], references: [tenantId, id])
  fiscalYear FiscalYear @relation(fields: [tenantId, fiscalYearId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, documentType, fiscalYearId])
  @@map("document_sequences")
}

// ---------------------------------------------------------------------------
// Phase 3 — Journal (double-entry)
// ---------------------------------------------------------------------------

model JournalEntry {
  id             BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId       BigInt             @map("tenant_id") @db.UnsignedBigInt
  companyId      BigInt             @map("company_id") @db.UnsignedBigInt
  branchId       BigInt?            @map("branch_id") @db.UnsignedBigInt
  entryNo        String?            @map("entry_no") @db.VarChar(50)
  entryDate      DateTime           @map("entry_date") @db.Date
  fiscalPeriodId BigInt?            @map("fiscal_period_id") @db.UnsignedBigInt
  sourceType     String             @map("source_type") @db.VarChar(50)
  sourceId       BigInt?            @map("source_id") @db.UnsignedBigInt
  postingKind    JournalPostingKind @default(POST) @map("posting_kind")
  voucherType    JournalVoucherType @default(JOURNAL) @map("voucher_type")
  status         JournalEntryStatus @default(DRAFT)
  description    String?            @db.VarChar(500)
  totalDebit     Decimal            @default(0) @map("total_debit") @db.Decimal(18, 3)
  totalCredit    Decimal            @default(0) @map("total_credit") @db.Decimal(18, 3)
  reversalOfId   BigInt?            @map("reversal_of_id") @db.UnsignedBigInt
  postedAt       DateTime?          @map("posted_at") @db.DateTime(3)
  postedBy       BigInt?            @map("posted_by") @db.UnsignedBigInt
  createdAt      DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company           @relation(fields: [tenantId, companyId], references: [tenantId, id])
  branch           Branch?           @relation(fields: [tenantId, branchId], references: [tenantId, id])
  fiscalPeriod     FiscalPeriod?     @relation(fields: [tenantId, fiscalPeriodId], references: [tenantId, id])
  reversalOf       JournalEntry?     @relation("EntryReversal", fields: [tenantId, reversalOfId], references: [tenantId, id])
  reversals        JournalEntry[]    @relation("EntryReversal")
  lines            JournalLine[]
  stockAdjustments StockAdjustment[]

  @@unique([tenantId, id])
  // One POST + one REVERSAL per source document (docs/BUILD_PLAN.md §10.3).
  // MySQL treats NULL source_id as distinct — drafts set source_id = own id.
  @@unique([tenantId, sourceType, sourceId, postingKind])
  @@index([tenantId, companyId, entryDate])
  @@index([tenantId, status])
  @@map("journal_entries")
}

model JournalLine {
  id             BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId       BigInt            @map("tenant_id") @db.UnsignedBigInt
  journalEntryId BigInt            @map("journal_entry_id") @db.UnsignedBigInt
  lineNo         Int               @map("line_no")
  accountId      BigInt            @map("account_id") @db.UnsignedBigInt
  debit          Decimal           @default(0) @db.Decimal(18, 3)
  credit         Decimal           @default(0) @db.Decimal(18, 3)
  partyType      JournalPartyType? @map("party_type")
  partyId        BigInt?           @map("party_id") @db.UnsignedBigInt
  description    String?           @db.VarChar(500)
  branchId       BigInt?           @map("branch_id") @db.UnsignedBigInt
  createdAt      DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  entry   JournalEntry @relation(fields: [tenantId, journalEntryId], references: [tenantId, id], onDelete: Cascade)
  account Account      @relation(fields: [tenantId, accountId], references: [tenantId, id])
  tenant  Tenant       @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, id])
  @@unique([tenantId, journalEntryId, lineNo])
  @@index([tenantId, accountId])
  @@index([tenantId, partyType, partyId])
  @@map("journal_lines")
}

// ---------------------------------------------------------------------------
// Phase 4 — items, warehouses, stock ledger (docs/BUILD_PLAN.md §7.4, §9)
// ---------------------------------------------------------------------------

model ItemGroup {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId  BigInt   @map("tenant_id") @db.UnsignedBigInt
  code      String   @db.VarChar(50)
  nameAr    String   @map("name_ar") @db.VarChar(191)
  nameEn    String?  @map("name_en") @db.VarChar(191)
  parentId  BigInt?  @map("parent_id") @db.UnsignedBigInt
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   ItemGroup?  @relation("ItemGroupTree", fields: [tenantId, parentId], references: [tenantId, id])
  children ItemGroup[] @relation("ItemGroupTree")
  items    Item[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
  @@map("item_groups")
}

model Item {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId      BigInt   @map("tenant_id") @db.UnsignedBigInt
  companyId     BigInt   @map("company_id") @db.UnsignedBigInt
  code          String   @db.VarChar(50)
  nameAr        String   @map("name_ar") @db.VarChar(191)
  nameEn        String?  @map("name_en") @db.VarChar(191)
  description   String?  @db.VarChar(500)
  itemGroupId   BigInt?  @map("item_group_id") @db.UnsignedBigInt
  itemKind      ItemKind @default(STOCK) @map("item_kind")
  baseUnitId    BigInt   @map("base_unit_id") @db.UnsignedBigInt
  taxCategoryId BigInt?  @map("tax_category_id") @db.UnsignedBigInt
  salePrice     Decimal? @map("sale_price") @db.Decimal(18, 3)
  purchasePrice Decimal? @map("purchase_price") @db.Decimal(18, 3)
  minStock      Decimal  @default(0) @map("min_stock") @db.Decimal(18, 6)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy     BigInt?  @map("created_by") @db.UnsignedBigInt
  updatedBy     BigInt?  @map("updated_by") @db.UnsignedBigInt

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company         Company               @relation(fields: [tenantId, companyId], references: [tenantId, id])
  itemGroup       ItemGroup?            @relation(fields: [tenantId, itemGroupId], references: [tenantId, id])
  baseUnit        Unit                  @relation("ItemBaseUnit", fields: [tenantId, baseUnitId], references: [tenantId, id])
  taxCategory     TaxCategory?          @relation(fields: [tenantId, taxCategoryId], references: [tenantId, id])
  units           ItemUnit[]
  barcodes        ItemBarcode[]
  movements       StockMovement[]
  balances        StockBalance[]
  costs           ItemCost[]
  adjustmentLines StockAdjustmentLine[]
  transferLines   StockTransferLine[]
  countLines      StockCountLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, code])
  @@index([tenantId, itemKind])
  @@map("items")
}

model ItemUnit {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId          BigInt   @map("tenant_id") @db.UnsignedBigInt
  itemId            BigInt   @map("item_id") @db.UnsignedBigInt
  unitId            BigInt   @map("unit_id") @db.UnsignedBigInt
  factorToBase      Decimal  @map("factor_to_base") @db.Decimal(18, 6)
  isDefaultSale     Boolean  @default(false) @map("is_default_sale")
  isDefaultPurchase Boolean  @default(false) @map("is_default_purchase")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item     Item          @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade)
  unit     Unit          @relation(fields: [tenantId, unitId], references: [tenantId, id])
  barcodes ItemBarcode[]

  @@unique([tenantId, id])
  @@unique([tenantId, itemId, unitId])
  @@map("item_units")
}

model ItemBarcode {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId   BigInt   @map("tenant_id") @db.UnsignedBigInt
  itemId     BigInt   @map("item_id") @db.UnsignedBigInt
  itemUnitId BigInt?  @map("item_unit_id") @db.UnsignedBigInt
  barcode    String   @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item     Item      @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade)
  itemUnit ItemUnit? @relation(fields: [tenantId, itemUnitId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, barcode])
  @@map("item_barcodes")
}

model Warehouse {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId  BigInt   @map("tenant_id") @db.UnsignedBigInt
  companyId BigInt   @map("company_id") @db.UnsignedBigInt
  branchId  BigInt?  @map("branch_id") @db.UnsignedBigInt
  code      String   @db.VarChar(50)
  nameAr    String   @map("name_ar") @db.VarChar(191)
  nameEn    String?  @map("name_en") @db.VarChar(191)
  address   String?  @db.VarChar(512)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy BigInt?  @map("created_by") @db.UnsignedBigInt
  updatedBy BigInt?  @map("updated_by") @db.UnsignedBigInt

  tenant        Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company       Company           @relation(fields: [tenantId, companyId], references: [tenantId, id])
  branch        Branch?           @relation(fields: [tenantId, branchId], references: [tenantId, id])
  movements     StockMovement[]
  balances      StockBalance[]
  adjustments   StockAdjustment[]
  transfersFrom StockTransfer[]   @relation("TransferFrom")
  transfersTo   StockTransfer[]   @relation("TransferTo")
  counts        StockCount[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, code])
  @@map("warehouses")
}

model StockMovement {
  id              BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId        BigInt            @map("tenant_id") @db.UnsignedBigInt
  companyId       BigInt            @map("company_id") @db.UnsignedBigInt
  warehouseId     BigInt            @map("warehouse_id") @db.UnsignedBigInt
  itemId          BigInt            @map("item_id") @db.UnsignedBigInt
  movementDate    DateTime          @map("movement_date") @db.Date
  movementType    StockMovementType @map("movement_type")
  sourceType      String            @map("source_type") @db.VarChar(50)
  sourceId        BigInt?           @map("source_id") @db.UnsignedBigInt
  sourceLineId    BigInt?           @map("source_line_id") @db.UnsignedBigInt
  qtyIn           Decimal           @default(0) @map("qty_in") @db.Decimal(18, 6)
  qtyOut          Decimal           @default(0) @map("qty_out") @db.Decimal(18, 6)
  unitCost        Decimal           @map("unit_cost") @db.Decimal(18, 3)
  totalCost       Decimal           @map("total_cost") @db.Decimal(18, 3)
  balanceQtyAfter Decimal           @map("balance_qty_after") @db.Decimal(18, 6)
  avgCostAfter    Decimal           @map("avg_cost_after") @db.Decimal(18, 6)
  reversalOfId    BigInt?           @map("reversal_of_id") @db.UnsignedBigInt
  createdAt       DateTime          @default(now()) @map("created_at") @db.DateTime(3)

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company    Company         @relation(fields: [tenantId, companyId], references: [tenantId, id])
  warehouse  Warehouse       @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  item       Item            @relation(fields: [tenantId, itemId], references: [tenantId, id])
  reversalOf StockMovement?  @relation("MovementReversal", fields: [tenantId, reversalOfId], references: [tenantId, id])
  reversals  StockMovement[] @relation("MovementReversal")

  @@unique([tenantId, id])
  @@index([tenantId, warehouseId, itemId])
  @@index([tenantId, itemId, movementDate])
  @@index([tenantId, sourceType, sourceId])
  @@map("stock_movements")
}

model StockBalance {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId         BigInt    @map("tenant_id") @db.UnsignedBigInt
  warehouseId      BigInt    @map("warehouse_id") @db.UnsignedBigInt
  itemId           BigInt    @map("item_id") @db.UnsignedBigInt
  qtyOnHand        Decimal   @default(0) @map("qty_on_hand") @db.Decimal(18, 6)
  lastMovementDate DateTime? @map("last_movement_date") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [tenantId, warehouseId], references: [tenantId, id], onDelete: Cascade)
  item      Item      @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, warehouseId, itemId])
  @@map("stock_balances")
}

model ItemCost {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId         BigInt    @map("tenant_id") @db.UnsignedBigInt
  companyId        BigInt    @map("company_id") @db.UnsignedBigInt
  itemId           BigInt    @map("item_id") @db.UnsignedBigInt
  totalQty         Decimal   @default(0) @map("total_qty") @db.Decimal(18, 6)
  totalValue       Decimal   @default(0) @map("total_value") @db.Decimal(18, 3)
  avgCost          Decimal   @default(0) @map("avg_cost") @db.Decimal(18, 6)
  lastMovementDate DateTime? @map("last_movement_date") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [tenantId, companyId], references: [tenantId, id])
  item    Item    @relation(fields: [tenantId, itemId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, itemId])
  @@map("item_costs")
}

model StockAdjustment {
  id             BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId       BigInt              @map("tenant_id") @db.UnsignedBigInt
  companyId      BigInt              @map("company_id") @db.UnsignedBigInt
  warehouseId    BigInt              @map("warehouse_id") @db.UnsignedBigInt
  adjustmentDate DateTime            @map("adjustment_date") @db.Date
  adjustmentType StockAdjustmentType @map("adjustment_type")
  status         DocumentStatus      @default(DRAFT)
  docNo          String?             @map("doc_no") @db.VarChar(50)
  description    String?             @db.VarChar(500)
  journalEntryId BigInt?             @map("journal_entry_id") @db.UnsignedBigInt
  reversalOfId   BigInt?             @map("reversal_of_id") @db.UnsignedBigInt
  postedAt       DateTime?           @map("posted_at") @db.DateTime(3)
  postedBy       BigInt?             @map("posted_by") @db.UnsignedBigInt
  createdAt      DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.DateTime(3)

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company      Company               @relation(fields: [tenantId, companyId], references: [tenantId, id])
  warehouse    Warehouse             @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  journalEntry JournalEntry?         @relation(fields: [tenantId, journalEntryId], references: [tenantId, id])
  reversalOf   StockAdjustment?      @relation("AdjustmentReversal", fields: [tenantId, reversalOfId], references: [tenantId, id])
  reversals    StockAdjustment[]     @relation("AdjustmentReversal")
  lines        StockAdjustmentLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, docNo])
  @@index([tenantId, status])
  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId     BigInt   @map("tenant_id") @db.UnsignedBigInt
  adjustmentId BigInt   @map("adjustment_id") @db.UnsignedBigInt
  lineNo       Int      @map("line_no")
  itemId       BigInt   @map("item_id") @db.UnsignedBigInt
  qtyIn        Decimal  @default(0) @map("qty_in") @db.Decimal(18, 6)
  qtyOut       Decimal  @default(0) @map("qty_out") @db.Decimal(18, 6)
  unitCost     Decimal? @map("unit_cost") @db.Decimal(18, 3)
  description  String?  @db.VarChar(500)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant     Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  adjustment StockAdjustment @relation(fields: [tenantId, adjustmentId], references: [tenantId, id], onDelete: Cascade)
  item       Item            @relation(fields: [tenantId, itemId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, adjustmentId, lineNo])
  @@map("stock_adjustment_lines")
}

model StockTransfer {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId        BigInt         @map("tenant_id") @db.UnsignedBigInt
  companyId       BigInt         @map("company_id") @db.UnsignedBigInt
  transferDate    DateTime       @map("transfer_date") @db.Date
  fromWarehouseId BigInt         @map("from_warehouse_id") @db.UnsignedBigInt
  toWarehouseId   BigInt         @map("to_warehouse_id") @db.UnsignedBigInt
  status          DocumentStatus @default(DRAFT)
  docNo           String?        @map("doc_no") @db.VarChar(50)
  description     String?        @db.VarChar(500)
  reversalOfId    BigInt?        @map("reversal_of_id") @db.UnsignedBigInt
  postedAt        DateTime?      @map("posted_at") @db.DateTime(3)
  postedBy        BigInt?        @map("posted_by") @db.UnsignedBigInt
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company       Company             @relation(fields: [tenantId, companyId], references: [tenantId, id])
  fromWarehouse Warehouse           @relation("TransferFrom", fields: [tenantId, fromWarehouseId], references: [tenantId, id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [tenantId, toWarehouseId], references: [tenantId, id])
  reversalOf    StockTransfer?      @relation("TransferReversal", fields: [tenantId, reversalOfId], references: [tenantId, id])
  reversals     StockTransfer[]     @relation("TransferReversal")
  lines         StockTransferLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, docNo])
  @@index([tenantId, status])
  @@map("stock_transfers")
}

model StockTransferLine {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId   BigInt   @map("tenant_id") @db.UnsignedBigInt
  transferId BigInt   @map("transfer_id") @db.UnsignedBigInt
  lineNo     Int      @map("line_no")
  itemId     BigInt   @map("item_id") @db.UnsignedBigInt
  qty        Decimal  @db.Decimal(18, 6)
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transfer StockTransfer @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Cascade)
  item     Item          @relation(fields: [tenantId, itemId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, transferId, lineNo])
  @@map("stock_transfer_lines")
}

model StockCount {
  id           BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId     BigInt         @map("tenant_id") @db.UnsignedBigInt
  companyId    BigInt         @map("company_id") @db.UnsignedBigInt
  warehouseId  BigInt         @map("warehouse_id") @db.UnsignedBigInt
  countDate    DateTime       @map("count_date") @db.Date
  status       DocumentStatus @default(DRAFT)
  docNo        String?        @map("doc_no") @db.VarChar(50)
  description  String?        @db.VarChar(500)
  adjustmentId BigInt?        @map("adjustment_id") @db.UnsignedBigInt
  postedAt     DateTime?      @map("posted_at") @db.DateTime(3)
  postedBy     BigInt?        @map("posted_by") @db.UnsignedBigInt
  createdAt    DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.DateTime(3)

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company   Company          @relation(fields: [tenantId, companyId], references: [tenantId, id])
  warehouse Warehouse        @relation(fields: [tenantId, warehouseId], references: [tenantId, id])
  lines     StockCountLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, docNo])
  @@index([tenantId, status])
  @@map("stock_counts")
}

model StockCountLine {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId      BigInt   @map("tenant_id") @db.UnsignedBigInt
  countId       BigInt   @map("count_id") @db.UnsignedBigInt
  itemId        BigInt   @map("item_id") @db.UnsignedBigInt
  systemQty     Decimal  @map("system_qty") @db.Decimal(18, 6)
  countedQty    Decimal? @map("counted_qty") @db.Decimal(18, 6)
  differenceQty Decimal? @map("difference_qty") @db.Decimal(18, 6)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  tenant Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  count  StockCount @relation(fields: [tenantId, countId], references: [tenantId, id], onDelete: Cascade)
  item   Item       @relation(fields: [tenantId, itemId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@unique([tenantId, countId, itemId])
  @@map("stock_count_lines")
}
