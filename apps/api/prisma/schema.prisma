// ---------------------------------------------------------------------------
// Phase 5 — parties, sales/purchases, returns, treasury, goods notes
// (docs/BUILD_PLAN.md §7.5–§7.8)
// ---------------------------------------------------------------------------

enum PartyType {
  CUSTOMER
  SUPPLIER
  BOTH
}

enum InvoicePaymentType {
  CASH
  CREDIT
}

enum GoodsNoteType {
  GRN
  GIN
}

model Party {
  id               BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tenantId         BigInt    @map("tenant_id") @db.UnsignedBigInt
  companyId        BigInt    @map("company_id") @db.UnsignedBigInt
  code             String    @db.VarChar(50)
  nameAr           String    @map("name_ar") @db.VarChar(191)
  nameEn           String?   @map("name_en") @db.VarChar(191)
  partyType        PartyType @map("party_type")
  taxNumber        String?   @map("tax_number") @db.VarChar(50)
  nationalId       String?   @map("national_id") @db.VarChar(50)
  /// JoFotara buyer scheme for national_id (0005 §5): NIN Jordanian, PN non-Jordanian.
  nationalIdKind   NationalIdKind @default(NIN) @map("national_id_kind")
  phone            String?   @db.VarChar(50)
  address          String?   @db.VarChar(512)
  city             String?   @db.VarChar(100)
  creditLimit      Decimal?  @map("credit_limit") @db.Decimal(18, 3)
  paymentTermsDays Int?      @map("payment_terms_days")
  isCashCustomer   Boolean   @default(false) @map("is_cash_customer")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  createdBy        BigInt?   @map("created_by") @db.UnsignedBigInt
  updatedBy        BigInt?   @map("updated_by") @db.UnsignedBigInt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  company          Company           @relation(fields: [tenantId, companyId], references: [tenantId, id])
  salesInvoices    SalesInvoice[]
  purchaseInvoices PurchaseInvoice[]
  salesReturns     SalesReturn[]
  purchaseReturns  PurchaseReturn[]
  receipts         Receipt[]
  payments         Payment[]
  allocations      Allocation[]

  @@unique([tenantId, id])
  @@unique([tenantId, companyId, code])
  @@index([tenantId, partyType])
  @@map("parties")
}

model CashBox {
