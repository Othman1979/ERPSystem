DATABASE_URL="mysql://root:@localhost:3306/erp_dev"
# Database connections of the API's pool. Each Cron command has its own pool of 2, unless its line
# passes one: DB_POOL_SIZE=4 node dist/jobs/cli.js backup. Keep the API's pool plus the Cron pools
# that can run at once under the host's max_user_connections.
DB_POOL_SIZE=10
# Milliseconds a query waits for a free connection before it fails
DB_POOL_ACQUIRE_TIMEOUT_MS=10000
# ADR-045: shared preserves the current database layout; isolated routes tenants to their own databases
TENANCY_MODE=shared
TENANT_DB_POOL_SIZE=3
TENANT_DB_IDLE_MS=600000
TENANT_DB_MAX_POOLS=50
TENANT_DB_STATE_TTL_MS=30000
# isolated mode only: create uses TENANT_DB_ADMIN_URL; pool uses owner-added databases
DB_PROVISIONER=
TENANT_DB_ADMIN_URL=
TENANT_DB_HOST=
TENANT_DB_NAME_PREFIX=erp_t_
TENANT_DB_USER_HOST=%
TENANT_DB_POOL_LOW_WATER=5
TENANT_DB_POOL_TARGET=3
# Used only by job:db-pool-add; set for that command and do not keep it in this file.
# TENANT_DB_PASSWORD=
# Required only for TENANCY_MODE=isolated: 32 random bytes, base64
TENANT_DB_SECRET_KEY=
API_PORT=3001
# Node hosting panels give the app its port in PORT (set by the panel, not here). It is used only
# when API_PORT is empty (API_PORT=), so leave API_PORT empty on such a host.
# PORT=3001
CORS_ORIGIN="http://localhost:5173"
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# JoFotara (docs/decisions/0005): 32 random bytes, base64 — e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EINVOICE_ENC_KEY=""
# on | off — the in-process outbox loop (development only). Production sends with Cron every
# minute: node dist/jobs/cli.js einvoice-send (ADR-009 §15, no daemon)
EINVOICE_WORKER=off
EINVOICE_WORKER_INTERVAL_MS=60000
EINVOICE_HTTP_TIMEOUT_MS=30000
# Hosts a SANDBOX URL may use besides 127.0.0.1 / localhost (comma-separated)
EINVOICE_SANDBOX_HOSTS=
# PRODUCTION e-invoicing (real JoFotara) on a server that is not NODE_ENV=production:
# only with true (decisions.md TRADE-24). true | false, empty: false
EINVOICE_ALLOW_PRODUCTION=
# Report exports: most rows a PDF / XLSX export may have (413 REPORT_TOO_LARGE above)
REPORT_PDF_MAX_ROWS=1000
REPORT_XLSX_MAX_ROWS=50000
# Proxies whose X-Forwarded-For gives the client address (ADR-011): false, a hop count,
# or addresses/subnets, e.g. "loopback, 10.0.0.0/8". Never "true" on a public server.
TRUST_PROXY=loopback
# Subscriptions (Phase 9, ADR-009): trial days at registration, grace days after a
# paid period ends, days data is kept after cancellation (never deleted automatically)
TRIAL_DAYS=14
GRACE_DAYS=7
RETENTION_DAYS=90
# Uploaded files (company logo), outside the web root; relative to the API folder or absolute
STORAGE_DIR=storage
# Launch (Phase 10, ADR-010). In production (NODE_ENV=production) the API refuses to start unless
# JWT_ACCESS_SECRET has 32+ characters, CORS_ORIGIN is the site's https:// address,
# EINVOICE_ENC_KEY and BACKUP_ENCRYPTION_KEY are set, no secret is a placeholder (change-me,
# dev-only, example), DATABASE_URL is not root and has a password, and EINVOICE_WORKER=off.
# Check a server with: node dist/jobs/cli.js preflight
NODE_ENV=development
# NODE_ENV=test opens test-only routes: refused outside a Jest run unless ALLOW_TEST_ENV=true
# (a deliberate manual test run only; never on a server). true | false, empty: false
ALLOW_TEST_ENV=
# The built web app to serve on the same origin, e.g. ../web/dist (empty: API only)
WEB_DIST_DIR=
# OpenAPI pages at /api/docs: on | off (empty: on, off in production)
API_DOCS=
# Tests only: append every 2xx answer that does not match its OpenAPI schema to this file
# (CI sets it for the e2e run; ignored in production). Empty: off.
OPENAPI_RESPONSE_AUDIT=
# Daily backups (docs/runbooks/backup-restore.md): folder outside the web root and apart from
# STORAGE_DIR, days kept, the client tools (XAMPP: C:/xampp/mysql/bin/mysqldump.exe and mysql.exe;
# MariaDB: mariadb-dump and mariadb), and a scratch database for backup-verify (dropped and
# recreated each time; its name must contain restore or verify)
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql
BACKUP_VERIFY_DATABASE_URL=
# Error alerts (ADR-010 §10.3): the hourly error-digest command posts new errors to this webhook
# (Slack / Discord / Mattermost, or a Telegram sendMessage URL with chat_id). Empty: no alerts.
ALERT_WEBHOOK_URL=
# Backup encryption (ADR-010 §10.2): 32 random bytes, base64, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Every backup file is AES-256-GCM encrypted; backup-verify needs the same key. Keep a copy
# OFF the server (password manager): without it no backup can be restored. Required in production.
BACKUP_ENCRYPTION_KEY=
# Errors the monitor could not write to the database (disk full, database down) are appended
# here as JSON lines, and the hourly error-digest alerts them (ADR-010 §10.3).
ERROR_LOG_FILE=logs/errors-fallback.log
