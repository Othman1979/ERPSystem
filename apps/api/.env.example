DATABASE_URL="mysql://root:@localhost:3306/erp_dev"
# Database connections per process: the API and each Cron command have their own pool. Keep the
# API's pool plus the Cron pools that can run at once under the host's max_user_connections.
# A Cron line may pass a smaller one: DB_POOL_SIZE=2 node dist/jobs/cli.js backup
DB_POOL_SIZE=10
# Milliseconds a query waits for a free connection before it fails
DB_POOL_ACQUIRE_TIMEOUT_MS=10000
API_PORT=3001
CORS_ORIGIN="http://localhost:5173"
JWT_ACCESS_SECRET="dev-only-access-secret-change-me"
JWT_REFRESH_SECRET="dev-only-refresh-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# JoFotara (docs/decisions/0005): 32 random bytes, base64 — e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EINVOICE_ENC_KEY=""
# on | off — the in-process outbox loop (development only). Production sends with Cron every
# minute: node dist/jobs/cli.js einvoice-send (ADR-009 §15, no daemon)
EINVOICE_WORKER=off
EINVOICE_WORKER_INTERVAL_MS=60000
EINVOICE_HTTP_TIMEOUT_MS=30000
# Hosts a SANDBOX URL may use besides 127.0.0.1 / localhost (comma-separated)
EINVOICE_SANDBOX_HOSTS=
# Report exports: most rows a PDF / XLSX export may have (413 REPORT_TOO_LARGE above)
REPORT_PDF_MAX_ROWS=1000
REPORT_XLSX_MAX_ROWS=50000
# Proxies whose X-Forwarded-For gives the client address (ADR-011): false, a hop count,
# or addresses/subnets, e.g. "loopback, 10.0.0.0/8". Never "true" on a public server.
TRUST_PROXY=loopback
# Subscriptions (Phase 9, ADR-009): trial days at registration, grace days after a
# paid period ends, days data is kept after cancellation (never deleted automatically)
TRIAL_DAYS=14
GRACE_DAYS=7
RETENTION_DAYS=90
# Uploaded files (company logo), outside the web root; relative to the API folder or absolute
STORAGE_DIR=storage
# Launch (Phase 10, ADR-010). In production (NODE_ENV=production) the API refuses to start unless
# JWT_ACCESS_SECRET has 32+ characters, CORS_ORIGIN is the site's https:// address,
# EINVOICE_ENC_KEY is set and EINVOICE_WORKER=off. Check a server with: node dist/jobs/cli.js preflight
NODE_ENV=development
# The built web app to serve on the same origin, e.g. ../web/dist (empty: API only)
WEB_DIST_DIR=
# OpenAPI pages at /api/docs: on | off (empty: on, off in production)
API_DOCS=
# Daily backups (docs/runbooks/backup-restore.md): folder outside the web root and apart from
# STORAGE_DIR, days kept, the client tools (XAMPP: C:/xampp/mysql/bin/mysqldump.exe and mysql.exe;
# MariaDB: mariadb-dump and mariadb), and a scratch database for backup-verify (dropped and
# recreated each time; its name must contain restore or verify)
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql
BACKUP_VERIFY_DATABASE_URL=
# Error alerts (ADR-010 §10.3): the hourly error-digest command posts new errors to this webhook
# (Slack / Discord / Mattermost, or a Telegram sendMessage URL with chat_id). Empty: no alerts.
ALERT_WEBHOOK_URL=
