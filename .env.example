# Copy to .env for local development. Never commit real secrets.
DATABASE_URL="mysql://root:@localhost:3306/erp_dev"
API_PORT=3001
WEB_PORT=5173
CORS_ORIGIN="http://localhost:5173"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
# JoFotara (docs/decisions/0005): 32 random bytes, base64 — e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EINVOICE_ENC_KEY=""
# on | off — the outbox worker that sends documents to JoFotara
EINVOICE_WORKER=on
EINVOICE_WORKER_INTERVAL_MS=60000
EINVOICE_HTTP_TIMEOUT_MS=30000
